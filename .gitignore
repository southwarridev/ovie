run_tests.ps1
run_tests.sh
build-binaries.ps1
package-release.ps1
get-ovie.bat
install_ovie_simple.ps1
windows-install-helper.bat

# VS Code extension artifacts
extensions/*/out/
extensions/*/*.vsix
extensions/*/node_modules/
extensions/*/.vscode-test/

# Additional test artifacts
test_*.exe
test_*.o
test_*.rcgu.o
*.long-type-*.txt

