vendor/
.ovie/registry/
.ovie/cache/

# Test artifacts and temporary projects
test-*/
demo-*/
benchmark-results/
coverage/

# Documentation build artifacts
docs/_build/
docs/.doctrees/
site/

# Backup files
*.bak
*.backup
*.orig

# Lock files (keep local)
*.lock
!Cargo.lock

# CI/CD artifacts (prevent accidental commits of CI secrets)
.github/secrets/
.gitlab/secrets/
ci-secrets/

# Local development overrides
local-config/
dev-overrides/
.local/

# Performance and profiling data
*.prof
perf.data*
flamegraph.svg

# Ovie compiler artifacts
*.ov.ir
*.ov.wasm
*.ov.ll
output.*

# Keep the project truly offline-first
# Block any files that might contain URLs or network references
*-urls.txt
*-endpoints.txt
*-remotes.txt
network-*.json
remote-*.toml
# VS Code extension artifacts
extensions/*/out/
extensions/*/*.vsix
extensions/*/node_modules/
extensions/*/.vscode-test/

# Additional test artifacts that might be generated
test_*.exe
test_*.o
test_*.rcgu.o
*.long-type-*.txt