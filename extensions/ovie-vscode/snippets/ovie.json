{
  "oya constant": { "prefix": "oya", "body": ["oya ${1:Name} = ${2:value}"], "description": "Immutable variable — use by default" },
  "mut variable": { "prefix": "mut", "body": ["mut ${1:Name} = ${2:value}"], "description": "Mutable variable" },
  "seeAm print": { "prefix": "seeAm", "body": ["seeAm ${1:value}"], "description": "Print to terminal (Nigerian Pidgin)" },
  "if statement": { "prefix": "if", "body": ["if ${1:condition} {", "    ${2}", "}"], "description": "If statement" },
  "if/else": { "prefix": "ife", "body": ["if ${1:condition} {", "    ${2}", "} else {", "    ${3}", "}"], "description": "If else" },
  "while loop": { "prefix": "while", "body": ["while ${1:condition} {", "    ${2}", "}"], "description": "While loop" },
  "running loop": { "prefix": "wrun", "body": ["mut running = true", "while running {", "    print(${1:prompt})", "    mut input = string_trim(read_line())", "    if input == ${2:q} { running = false }", "    ${3}", "}"], "description": "Safe input loop pattern" },
  "for range": { "prefix": "for", "body": ["for ${1:i} in 0..${2:n} {", "    ${3}", "}"], "description": "For loop over range" },
  "enum define": { "prefix": "enum", "body": ["enum ${1:Name} {", "    ${2},", "    ${3},", "}"], "description": "Define an enum" },
  "match": { "prefix": "match", "body": ["match ${1:value} {", "    ${2} => ${3},", "}"], "description": "Pattern matching" },
  "oya config": { "prefix": "oyaconfig", "body": ["oya APP_NAME = " + [char]92 + [char]34 + 'My App' + [char]92 + [char]34 + "", "oya VERSION  = " + [char]92 + [char]34 + '1.0.0' + [char]92 + [char]34 + "", "oya QUIT_CMD = " + [char]92 + [char]34 + 'q' + [char]92 + [char]34 + ""], "description": "oya constants for app config" },
  "use stdlib": { "prefix": "use", "body": ["use std::${1:name}::{${2:value}}"], "description": "Import from stdlib" }
}