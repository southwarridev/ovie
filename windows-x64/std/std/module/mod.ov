    StringInterner,
    HashState,
    CacheIndex,
    LoadTiming,
    LoadStats,
    new_interner,
    intern,
    resolve_interned,
    new_hash_state,
    update_hash,
    finalize_hash,
    compute_seeded_hash,
    compute_deps_hash_fast,
    new_cache_index,
    hot_check,
    update_hot_index,
    invalidate_hot,
    build_graph_fast,
    prewarm_stdlib,
    new_load_stats,
    record_timing,
