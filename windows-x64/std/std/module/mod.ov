/// Ovie Module System
/// 
/// This module provides the core functionality for Ovie's module system,
/// including module loading, path resolution, dependency management,
/// and caching.
///
/// # Components
/// - `types`: Core data structures for modules, imports, and exports
/// - `loader`: Module loading and management
/// - `resolver`: Module path resolution
///
/// # Examples
/// ```
/// use std::module::{load_module, resolve};
/// 
/// // Load a module
/// let module = load_module("std/math/mod.ov")?;
/// 
/// // Resolve a module path
/// let config = default_config();
/// let resolved = resolve("std::math", config)?;
/// ```

// Re-export core types
export use ./types::{
    Module,
    Import,
    ExportTable,
    FunctionSignature,
    Parameter,
    Type,
    TypeDefinition,
    TypeKind,
    Field,
    ConstantInfo,
    EnumDefinition,
    EnumVariant,
    ModuleError,
    ModuleResult
};

// Re-export loader functions
export use ./loader::{
    load_module,
    load_dependencies,
    is_loaded,
    get_module,
    register_export,
    validate_imports,
    load_module_from_source,
    is_standalone_file,
    load_standalone,
    load_with_compat,
    is_legacy_module,
    default_compat_mode,
    strict_compat_mode,
    load_with_mode,
    has_legacy_std_usage
};

// Re-export resolver functions
export use ./resolver::{
    ResolverConfig,
    ResolvedModule,
    ModuleType,
    default_config,
    resolve,
    path_to_file,
    search_paths,
    normalize_path,
    is_valid_module
};

// Re-export migration tools
export use ./migrate::{
    MigrateConfig,
    MigrateResult,
    MigrationChange,
    ChangeKind,
    migrate_file,
    migrate_directory,
    default_migrate_config,
    generate_ovie_toml,
    analyze_used_symbols
};

