fn test_is_legacy_module_true_for_standalone_loaded() {
    let src = "fn main() {}".to_string();
    match load_with_compat("legacy_check_a.ov".to_string(), src) {
        Ok(module) => {
            assert(is_legacy_module(&module), "Standalone module should be legacy");
            io::println("✓ test_is_legacy_module_true_for_standalone_loaded passed");
        },
        Err(e) => io::println("✗ test_is_legacy_module_true_for_standalone_loaded failed: {}", e)
    }
}

fn test_is_legacy_module_false_for_modular_loaded() {
    let src = "export fn foo() {}".to_string();
    match load_with_compat("legacy_check_b.ov".to_string(), src) {
        Ok(module) => {
            assert(!is_legacy_module(&module), "Modular module should not be legacy");
            io::println("✓ test_is_legacy_module_false_for_modular_loaded passed");
        },
        Err(e) => io::println("✗ test_is_legacy_module_false_for_modular_loaded failed: {}", e)
    }
}

fn test_is_legacy_module_reflects_is_standalone_field() {
    let src = "fn helper() {}\nfn main() {}".to_string();
    match load_with_compat("legacy_check_c.ov".to_string(), src) {
        Ok(module) => {
            assert(is_legacy_module(&module) == module.is_standalone,
                   "is_legacy_module should equal module.is_standalone");
            io::println("✓ test_is_legacy_module_reflects_is_standalone_field passed");
        },
        Err(e) => io::println("✗ test_is_legacy_module_reflects_is_standalone_field failed: {}", e)
    }
}

