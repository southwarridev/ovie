/// Integration Tests — Backward Compatibility (Task 19.2)
///
/// Exhaustive tests for the backward compatibility layer (Phase 4, tasks 17.1, 17.2).
/// Verifies that:
///   - Standalone .ov files (no import/export) still compile and load correctly
///   - Mixed standalone and modular code coexists without conflict
///   - Legacy std usage patterns are detected and can be migrated
///   - Compatibility modes (default/strict) enforce the right rules
///   - The migrate tool correctly transforms legacy files
///   - Module.is_standalone is set correctly in all cases
///   - is_legacy_module reflects is_standalone accurately
///   - load_with_mode enforces strict mode and permits default mode

use std::io;
use std::core::{Vec, HashMap};
use ./loader::{
    is_standalone_file,
    load_standalone,
    load_with_compat,
    is_legacy_module,
    default_compat_mode,
    strict_compat_mode,
    load_with_mode,
    has_legacy_std_usage,
    is_loaded,
    get_module
};
use ./migrate::{
    migrate_file,
    default_migrate_config,
    analyze_used_symbols,
    generate_ovie_toml
};

// ============================================================
// SECTION 1: is_standalone_file — all edge cases
// ============================================================

fn test_standalone_empty_file() {
    assert(is_standalone_file(&"".to_string()), "Empty file should be standalone");
    io::println("✓ test_standalone_empty_file passed");
}

fn test_standalone_only_comments() {
    let src = "// just a comment\n// another comment".to_string();
    assert(is_standalone_file(&src), "Comments-only file should be standalone");
    io::println("✓ test_standalone_only_comments passed");
}

fn test_standalone_only_blank_lines() {
    let src = "\n\n\n\n".to_string();
    assert(is_standalone_file(&src), "Blank lines only should be standalone");
    io::println("✓ test_standalone_only_blank_lines passed");
}

fn test_standalone_simple_main() {
    let src = "fn main() { seeAm(\"hello\"); }".to_string();
    assert(is_standalone_file(&src), "Simple main should be standalone");
    io::println("✓ test_standalone_simple_main passed");
}

fn test_standalone_multiple_functions() {
    let src = "fn add(a: Number, b: Number) -> Number { a + b }\nfn main() { seeAm(add(1, 2)); }".to_string();
    assert(is_standalone_file(&src), "Multiple functions without module keywords should be standalone");
    io::println("✓ test_standalone_multiple_functions passed");
}

fn test_standalone_struct_definition() {
    let src = "struct Point { x: Number, y: Number }\nfn main() {}".to_string();
    assert(is_standalone_file(&src), "Struct definition without module keywords should be standalone");
    io::println("✓ test_standalone_struct_definition passed");
}

fn test_standalone_enum_definition() {
    let src = "enum Color { Red, Green, Blue }\nfn main() {}".to_string();
    assert(is_standalone_file(&src), "Enum definition without module keywords should be standalone");
    io::println("✓ test_standalone_enum_definition passed");
}

fn test_standalone_doc_comments_ignored() {
    let src = "/// This is a doc comment\n/// for the main function\nfn main() {}".to_string();
    assert(is_standalone_file(&src), "Doc comments should not affect standalone detection");
    io::println("✓ test_standalone_doc_comments_ignored passed");
}

fn test_not_standalone_use_at_top() {
    let src = "use std::core::{Vec};\nfn main() {}".to_string();
    assert(!is_standalone_file(&src), "File with 'use' should not be standalone");
    io::println("✓ test_not_standalone_use_at_top passed");
}

fn test_not_standalone_import_at_top() {
    let src = "import \"./utils.ov\";\nfn main() {}".to_string();
    assert(!is_standalone_file(&src), "File with 'import' should not be standalone");
    io::println("✓ test_not_standalone_import_at_top passed");
}

fn test_not_standalone_export_fn() {
    let src = "export fn add(a: Number, b: Number) -> Number { a + b }".to_string();
    assert(!is_standalone_file(&src), "File with 'export fn' should not be standalone");
    io::println("✓ test_not_standalone_export_fn passed");
}

fn test_not_standalone_export_struct() {
    let src = "export struct Config { debug: bool }".to_string();
    assert(!is_standalone_file(&src), "File with 'export struct' should not be standalone");
    io::println("✓ test_not_standalone_export_struct passed");
}

fn test_not_standalone_export_const() {
    let src = "export const MAX: Number = 100;".to_string();
    assert(!is_standalone_file(&src), "File with 'export const' should not be standalone");
    io::println("✓ test_not_standalone_export_const passed");
}

fn test_not_standalone_use_after_comments() {
    let src = "// header comment\nuse std::math::{sin};\nfn main() {}".to_string();
    assert(!is_standalone_file(&src), "use after comments should not be standalone");
    io::println("✓ test_not_standalone_use_after_comments passed");
}

fn test_not_standalone_export_in_middle_of_file() {
    let src = "fn helper() {}\nexport fn public_api() {}".to_string();
    assert(!is_standalone_file(&src), "export anywhere in file should not be standalone");
    io::println("✓ test_not_standalone_export_in_middle_of_file passed");
}

fn test_standalone_indented_fn_not_confused() {
    let src = "fn outer() {\n    fn inner() {}\n}".to_string();
    assert(is_standalone_file(&src), "Indented fn should not affect standalone detection");
    io::println("✓ test_standalone_indented_fn_not_confused passed");
}

