fn test_default_compat_allows_standalone() {
    let src = "fn main() {}".to_string();
    let mode = default_compat_mode();
    match load_with_mode("default_mode_a.ov".to_string(), src, mode) {
        Ok(_) => io::println("✓ test_default_compat_allows_standalone passed"),
        Err(e) => io::println("✗ test_default_compat_allows_standalone failed: {}", e)
    }
}

fn test_default_compat_allows_modular() {
    let src = "export fn foo() {}".to_string();
    let mode = default_compat_mode();
    match load_with_mode("default_mode_b.ov".to_string(), src, mode) {
        Ok(_) => io::println("✓ test_default_compat_allows_modular passed"),
        Err(e) => io::println("✗ test_default_compat_allows_modular failed: {}", e)
    }
}

fn test_strict_compat_rejects_standalone() {
    let src = "fn main() {}".to_string();
    let mode = strict_compat_mode();
    match load_with_mode("strict_mode_a.ov".to_string(), src, mode) {
        Ok(_) => assert(false, "Strict mode should reject standalone files"),
        Err(_) => io::println("✓ test_strict_compat_rejects_standalone passed")
    }
}

fn test_strict_compat_accepts_modular() {
    let src = "export fn bar() {}".to_string();
    let mode = strict_compat_mode();
    match load_with_mode("strict_mode_b.ov".to_string(), src, mode) {
        Ok(_) => io::println("✓ test_strict_compat_accepts_modular passed"),
        Err(e) => io::println("✗ test_strict_compat_accepts_modular failed: {}", e)
    }
}

fn test_strict_compat_accepts_use_statement() {
    let src = "use std::core::{Vec};\nfn main() {}".to_string();
    let mode = strict_compat_mode();
    match load_with_mode("strict_mode_c.ov".to_string(), src, mode) {
        Ok(_) => io::println("✓ test_strict_compat_accepts_use_statement passed"),
        Err(e) => io::println("✗ test_strict_compat_accepts_use_statement failed: {}", e)
    }
}

fn test_default_compat_standalone_result_is_standalone() {
    let src = "fn main() {}".to_string();
    let mode = default_compat_mode();
    match load_with_mode("default_standalone_check.ov".to_string(), src, mode) {
        Ok(module) => {
            assert(module.is_standalone, "Default mode standalone should set is_standalone=true");
            io::println("✓ test_default_compat_standalone_result_is_standalone passed");
        },
        Err(e) => io::println("✗ test_default_compat_standalone_result_is_standalone failed: {}", e)
    }
}

fn test_strict_compat_modular_result_not_standalone() {
    let src = "export fn compute() {}".to_string();
    let mode = strict_compat_mode();
    match load_with_mode("strict_modular_check.ov".to_string(), src, mode) {
        Ok(module) => {
            assert(!module.is_standalone, "Strict mode modular should set is_standalone=false");
            io::println("✓ test_strict_compat_modular_result_not_standalone passed");
        },
        Err(e) => io::println("✗ test_strict_compat_modular_result_not_standalone failed: {}", e)
    }
}

// ============================================================
// SECTION 7: Mixed standalone and modular coexistence
// ============================================================

fn test_standalone_and_modular_can_both_be_loaded() {
    let standalone_src = "fn main() {}".to_string();
    let modular_src = "export fn util() {}".to_string();
    match load_with_compat("mixed_standalone.ov".to_string(), standalone_src) {
        Ok(r1) => {
            match load_with_compat("mixed_modular.ov".to_string(), modular_src) {
                Ok(r2) => {
                    assert(r1.is_standalone, "Standalone should have is_standalone=true");
                    assert(!r2.is_standalone, "Modular should have is_standalone=false");
                    io::println("✓ test_standalone_and_modular_can_both_be_loaded passed");
                },
                Err(e) => io::println("✗ test_standalone_and_modular_can_both_be_loaded failed: {}", e)
            }
        },
        Err(e) => io::println("✗ test_standalone_and_modular_can_both_be_loaded failed: {}", e)
    }
}

fn test_multiple_standalone_files_independent() {
    let src_a = "fn greet() { seeAm(\"hi\"); }".to_string();
    let src_b = "fn farewell() { seeAm(\"bye\"); }".to_string();
    match load_with_compat("multi_standalone_a.ov".to_string(), src_a) {
        Ok(m_a) => {
            match load_with_compat("multi_standalone_b.ov".to_string(), src_b) {
                Ok(m_b) => {
                    assert(m_a.is_standalone, "m_a should be standalone");
                    assert(m_b.is_standalone, "m_b should be standalone");
                    assert(m_a.path != m_b.path, "Paths should differ");
                    assert(m_a.source_hash != m_b.source_hash, "Hashes should differ");
                    io::println("✓ test_multiple_standalone_files_independent passed");
                },
                Err(e) => io::println("✗ test_multiple_standalone_files_independent failed: {}", e)
            }
        },
        Err(e) => io::println("✗ test_multiple_standalone_files_independent failed: {}", e)
    }
}

fn test_multiple_modular_files_independent() {
    let src_a = "export fn alpha() {}".to_string();
    let src_b = "export fn beta() {}".to_string();
    match load_with_compat("multi_modular_a.ov".to_string(), src_a) {
        Ok(m_a) => {
            match load_with_compat("multi_modular_b.ov".to_string(), src_b) {
                Ok(m_b) => {
                    assert(!m_a.is_standalone, "m_a should not be standalone");
                    assert(!m_b.is_standalone, "m_b should not be standalone");
                    assert(m_a.path != m_b.path, "Paths should differ");
                    io::println("✓ test_multiple_modular_files_independent passed");
                },
                Err(e) => io::println("✗ test_multiple_modular_files_independent failed: {}", e)
            }
        },
        Err(e) => io::println("✗ test_multiple_modular_files_independent failed: {}", e)
    }
}

fn test_standalone_file_with_complex_logic() {
    let src = "struct Config { debug: bool, port: Number }\nenum Status { Ok, Err }\nfn run(cfg: Config) -> Status { Status::Ok }\nfn main() { let cfg = Config { debug: true, port: 8080 }; run(cfg); }".to_string();
    match load_with_compat("complex_standalone.ov".to_string(), src) {
        Ok(module) => {
            assert(module.is_standalone, "Complex standalone file should be standalone");
            io::println("✓ test_standalone_file_with_complex_logic passed");
        },
        Err(e) => io::println("✗ test_standalone_file_with_complex_logic failed: {}", e)
    }
}

// ============================================================
// SECTION 8: migrate.ov — legacy file transformation
// ============================================================

fn test_migrate_config_dry_run() {
    let mut config = default_migrate_config();
    config.write = false;
    assert(!config.write, "write should be false for dry run");
    assert(config.add_exports, "add_exports should be true by default");
    assert(config.fix_std_paths, "fix_std_paths should be true by default");
    io::println("✓ test_migrate_config_dry_run passed");
}

fn test_migrate_analyze_legacy_core_symbols() {
    let src = "use core::{Vec, HashMap};\nfn main() {}".to_string();
    let used = analyze_used_symbols(&src);
    assert(used.contains_key("std::core"), "Should detect std::core usage");
    io::println("✓ test_migrate_analyze_legacy_core_symbols passed");
}

fn test_migrate_analyze_legacy_math_symbols() {
    let src = "use math::{sin, cos, PI};\nfn compute() { let x = sin(PI); }".to_string();
    let used = analyze_used_symbols(&src);
    assert(used.contains_key("std::math"), "Should detect std::math usage");
    match used.get("std::math") {
        Some(syms) => {
            assert(syms.contains(&"sin".to_string()), "Should detect sin");
            assert(syms.contains(&"PI".to_string()), "Should detect PI");
        },
        None => assert(false, "std::math should be in used map")
    }
    io::println("✓ test_migrate_analyze_legacy_math_symbols passed");
}

fn test_migrate_file_nonexistent_path_fails_gracefully() {
    let config = default_migrate_config();
    let result = migrate_file("/does/not/exist/file.ov".to_string(), config);
    assert(!result.success, "Nonexistent file should fail");
    match result.error {
        Some(_) => io::println("✓ test_migrate_file_nonexistent_path_fails_gracefully passed"),
        None => assert(false, "Error should be Some for nonexistent file")
    }
}

fn test_generate_ovie_toml_structure() {
    let toml = generate_ovie_toml(&"legacy_app".to_string(), &"0.1.0".to_string());
    assert(toml.contains("[package]"), "TOML should have [package] section");
    assert(toml.contains("name = \"legacy_app\""), "TOML should have name field");
    assert(toml.contains("version = \"0.1.0\""), "TOML should have version field");
    assert(toml.contains("[dependencies]"), "TOML should have [dependencies] section");
    io::println("✓ test_generate_ovie_toml_structure passed");
}

fn test_generate_ovie_toml_is_valid_toml_structure() {
    let toml = generate_ovie_toml(&"test_pkg".to_string(), &"1.2.3".to_string());
    let pkg_pos = toml.find("[package]").unwrap();
    let dep_pos = toml.find("[dependencies]").unwrap();
    assert(pkg_pos < dep_pos, "[package] should come before [dependencies]");
    io::println("✓ test_generate_ovie_toml_is_valid_toml_structure passed");
}

// ============================================================
// SECTION 9: Property-based tests
// ============================================================

fn test_property_standalone_detection_consistent() {
    let standalone_sources = vec![
        "fn main() {}",
        "fn add(a: Number, b: Number) -> Number { a + b }",
        "struct Foo { x: Number }",
        "enum Bar { A, B, C }",
        "// just a comment",
        "",
        "\n\n\n",
        "fn a() {}\nfn b() {}\nfn c() {}"
    ];
    for src in standalone_sources {
        assert(is_standalone_file(&src.to_string()),
               "Source without module keywords should always be standalone");
    }
    io::println("✓ test_property_standalone_detection_consistent passed");
}

fn test_property_modular_detection_consistent() {
    let modular_sources = vec![
        "use std::core::{Vec};",
        "import \"./utils.ov\";",
        "export fn foo() {}",
        "export struct Bar {}",
        "export const X: Number = 1;",
        "use std::math::{sin};\nfn main() {}"
    ];
    for src in modular_sources {
        assert(!is_standalone_file(&src.to_string()),
               "Source with module keywords should never be standalone");
    }
    io::println("✓ test_property_modular_detection_consistent passed");
}

fn test_property_load_with_compat_never_panics() {
    let sources = vec![
        ("empty_prop.ov", ""),
        ("standalone_prop.ov", "fn main() {}"),
        ("modular_prop.ov", "export fn foo() {}"),
        ("use_stmt_prop.ov", "use std::core::{Vec};"),
        ("complex_prop.ov", "fn a() {}\nfn b() {}\nexport fn c() {}")
    ];
    for (path, src) in sources {
        let result = load_with_compat(path.to_string(), src.to_string());
        assert(result.is_ok() || result.is_err(), "load_with_compat should not panic");
    }
    io::println("✓ test_property_load_with_compat_never_panics passed");
}

fn test_property_is_legacy_equals_is_standalone_field() {
    let test_cases = vec![
        ("prop_legacy_a.ov", "fn main() {}", true),
        ("prop_legacy_b.ov", "export fn foo() {}", false),
        ("prop_legacy_c.ov", "use std::core::{Vec};\nfn main() {}", false)
    ];
    for (path, src, expected_standalone) in test_cases {
        match load_with_compat(path.to_string(), src.to_string()) {
            Ok(module) => {
                assert(is_legacy_module(&module) == module.is_standalone,
                       "is_legacy_module should equal module.is_standalone");
                assert(module.is_standalone == expected_standalone,
                       "is_standalone should match expected value");
            },
            Err(e) => io::println("✗ test_property_is_legacy_equals_is_standalone_field failed: {}", e)
        }
    }
    io::println("✓ test_property_is_legacy_equals_is_standalone_field passed");
}

