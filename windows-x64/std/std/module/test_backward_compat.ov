}

// ============================================================
// SECTION 3: load_standalone — standalone loading
// ============================================================

fn test_load_standalone_sets_is_standalone_true() {
    let src = "fn main() { seeAm(\"hello\"); }".to_string();
    match load_standalone("standalone_a.ov".to_string(), src) {
        Ok(module) => {
            assert(module.is_standalone, "load_standalone should set is_standalone=true");
            io::println("✓ test_load_standalone_sets_is_standalone_true passed");
        },
        Err(e) => io::println("✗ test_load_standalone_sets_is_standalone_true failed: {}", e)
    }
}

fn test_load_standalone_has_no_imports() {
    let src = "fn main() {}".to_string();
    match load_standalone("standalone_b.ov".to_string(), src) {
        Ok(module) => {
            assert(module.imports.is_empty(), "Standalone module should have no imports");
            io::println("✓ test_load_standalone_has_no_imports passed");
        },
        Err(e) => io::println("✗ test_load_standalone_has_no_imports failed: {}", e)
    }
}

fn test_load_standalone_path_preserved() {
    let src = "fn main() {}".to_string();
    match load_standalone("standalone_c.ov".to_string(), src) {
        Ok(module) => {
            assert(module.path == "standalone_c.ov".to_string(), "Path should be preserved");
            io::println("✓ test_load_standalone_path_preserved passed");
        },
        Err(e) => io::println("✗ test_load_standalone_path_preserved failed: {}", e)
    }
}

fn test_load_standalone_cached_on_second_call() {
    let src = "fn main() {}".to_string();
    let path = "standalone_cached.ov".to_string();
    match load_standalone(path.clone(), src.clone()) {
        Ok(m1) => {
            match load_standalone(path.clone(), src) {
                Ok(m2) => {
                    assert(m1.path == m2.path, "Cached module should have same path");
                    assert(m1.source_hash == m2.source_hash, "Cached module should have same hash");
                    io::println("✓ test_load_standalone_cached_on_second_call passed");
                },
                Err(e) => io::println("✗ test_load_standalone_cached_on_second_call failed: {}", e)
            }
        },
        Err(e) => io::println("✗ test_load_standalone_cached_on_second_call failed: {}", e)
    }
}

fn test_load_standalone_source_hash_set() {
    let src = "fn main() {}".to_string();
    match load_standalone("standalone_hash.ov".to_string(), src) {
        Ok(module) => {
            assert(!module.source_hash.is_empty(), "Source hash should be set");
            io::println("✓ test_load_standalone_source_hash_set passed");
        },
        Err(e) => io::println("✗ test_load_standalone_source_hash_set failed: {}", e)
    }
}

