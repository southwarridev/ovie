fn test_load_with_compat_standalone_source() {
    let src = "fn main() { seeAm(\"hello\"); }".to_string();
    match load_with_compat("compat_standalone.ov".to_string(), src) {
        Ok(module) => {
            assert(module.is_standalone, "Standalone source should set is_standalone=true");
            io::println("✓ test_load_with_compat_standalone_source passed");
        },
        Err(e) => io::println("✗ test_load_with_compat_standalone_source failed: {}", e)
    }
}

fn test_load_with_compat_modular_source() {
    let src = "export fn greet() -> String { \"hello\".to_string() }".to_string();
    match load_with_compat("compat_modular.ov".to_string(), src) {
        Ok(module) => {
            assert(!module.is_standalone, "Modular source should set is_standalone=false");
            io::println("✓ test_load_with_compat_modular_source passed");
        },
        Err(e) => io::println("✗ test_load_with_compat_modular_source failed: {}", e)
    }
}

fn test_load_with_compat_use_statement_is_modular() {
    let src = "use std::core::{Vec};\nfn main() {}".to_string();
    match load_with_compat("compat_use.ov".to_string(), src) {
        Ok(module) => {
            assert(!module.is_standalone, "File with 'use' should not be standalone");
            io::println("✓ test_load_with_compat_use_statement_is_modular passed");
        },
        Err(e) => io::println("✗ test_load_with_compat_use_statement_is_modular failed: {}", e)
    }
}

fn test_load_with_compat_import_statement_is_modular() {
    let src = "import \"./utils.ov\";\nfn main() {}".to_string();
    match load_with_compat("compat_import.ov".to_string(), src) {
        Ok(module) => {
            assert(!module.is_standalone, "File with 'import' should not be standalone");
            io::println("✓ test_load_with_compat_import_statement_is_modular passed");
        },
        Err(e) => io::println("✗ test_load_with_compat_import_statement_is_modular failed: {}", e)
    }
}

fn test_load_with_compat_registers_in_loader() {
    let src = "fn main() {}".to_string();
    let path = "compat_registered.ov".to_string();
    let _ = load_with_compat(path.clone(), src);
    assert(is_loaded(path), "Module should be registered after load_with_compat");
    io::println("✓ test_load_with_compat_registers_in_loader passed");
}

fn test_load_with_compat_get_module_after_load() {
    let src = "fn main() {}".to_string();
    let path = "compat_get.ov".to_string();
    let _ = load_with_compat(path.clone(), src);
    match get_module(path) {
        Some(_) => io::println("✓ test_load_with_compat_get_module_after_load passed"),
        None => assert(false, "get_module should return Some after load_with_compat")
    }
}

