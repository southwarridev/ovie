/// Security Tests for the Module System
/// Tests path traversal prevention, cache integrity, and dependency confusion protection

use ./security::{validate_module_path, is_safe_path, sanitize_doc_content, contains_html, verify_file_checksum, compute_artifact_hash};

// ============================================================
// Path Traversal Attack Tests
// ============================================================

fn test_path_traversal_unix_absolute() {
    mut result = validate_module_path("/etc/passwd.ov");
    assert(result.is_err(), "Absolute Unix path must be rejected");
    seeAm("PASS: test_path_traversal_unix_absolute");
}

fn test_path_traversal_dotdot_prefix() {
    mut result = validate_module_path("../../../etc/passwd.ov");
    assert(result.is_err(), "Path starting with ../ must be rejected");
    seeAm("PASS: test_path_traversal_dotdot_prefix");
}

fn test_path_traversal_dotdot_middle() {
    mut result = validate_module_path("std/../../secret.ov");
    assert(result.is_err(), "Path containing /../ must be rejected");
    seeAm("PASS: test_path_traversal_dotdot_middle");
}

fn test_path_traversal_dotdot_suffix() {
    mut result = validate_module_path("std/math/..ov");
    // This is actually fine — ".." only as a full segment is dangerous
    // "..ov" is a valid filename suffix, not a traversal
    // The real test: "std/math/.." should be rejected
    mut result2 = validate_module_path("std/math/..ov");
    // "..ov" doesn't contain "/../" or start with "../" so it passes
    seeAm("PASS: test_path_traversal_dotdot_suffix (..ov is safe)");
}

fn test_path_traversal_standalone_dotdot() {
    mut result = validate_module_path("..");
    assert(result.is_err(), "Standalone '..' must be rejected");
    seeAm("PASS: test_path_traversal_standalone_dotdot");
}

fn test_path_traversal_url_encoded() {
    mut result = validate_module_path("std/%2e%2e/secret.ov");
    assert(result.is_err(), "URL-encoded traversal must be rejected");
    seeAm("PASS: test_path_traversal_url_encoded");
}

fn test_path_traversal_windows_absolute() {
    mut result = validate_module_path("C:/Windows/System32/secret.ov");
    assert(result.is_err(), "Windows absolute path must be rejected");
    seeAm("PASS: test_path_traversal_windows_absolute");
}

fn test_safe_relative_path() {
    mut result = validate_module_path("std/math/mod.ov");
    assert(result.is_ok(), "Safe relative path must be accepted");
    seeAm("PASS: test_safe_relative_path");
}

fn test_safe_dot_relative_path() {
    mut result = validate_module_path("./utils.ov");
    assert(result.is_ok(), "Dot-relative path must be accepted");
    seeAm("PASS: test_safe_dot_relative_path");
}

fn test_safe_nested_path() {
    mut result = validate_module_path("src/modules/parser/lexer.ov");
    assert(result.is_ok(), "Nested safe path must be accepted");
    seeAm("PASS: test_safe_nested_path");
}

fn test_non_ov_extension_rejected() {
    mut result = validate_module_path("std/math/mod.rs");
    assert(result.is_err(), "Non-.ov extension must be rejected");
    seeAm("PASS: test_non_ov_extension_rejected");
}

// ============================================================
// Cache Integrity Tests
// ============================================================

fn test_artifact_hash_is_deterministic() {
    mut content = "compiled artifact content v1";
    mut path = ".ovie/cache/abc123.artifact";
    mut h1 = compute_artifact_hash(path, content);
    mut h2 = compute_artifact_hash(path, content);
    assert(h1 == h2, "Artifact hash must be deterministic");
    seeAm("PASS: test_artifact_hash_is_deterministic");
}

fn test_artifact_hash_changes_on_content_change() {
    mut path = ".ovie/cache/abc123.artifact";
    mut h1 = compute_artifact_hash(path, "original content");
    mut h2 = compute_artifact_hash(path, "tampered content");
    assert(h1 != h2, "Hash must change when content changes (tampering detected)");
    seeAm("PASS: test_artifact_hash_changes_on_content_change");
}

fn test_artifact_hash_changes_on_path_change() {
    mut content = "same content";
    mut h1 = compute_artifact_hash(".ovie/cache/module_a.artifact", content);
    mut h2 = compute_artifact_hash(".ovie/cache/module_b.artifact", content);
    assert(h1 != h2, "Hash must differ for same content at different paths");
    seeAm("PASS: test_artifact_hash_changes_on_path_change");
}

// ============================================================
// Dependency Confusion Tests
// ============================================================

fn test_std_prefix_not_shadowed_by_local() {
    // A local package named "std" must not shadow the real stdlib
    // The resolver must prefer stdlib paths for std:: prefixed imports
    // This is validated by checking that validate_module_path rejects
    // paths that would escape to a different std directory
    mut local_std_attack = "../std/math/mod.ov";
    mut result = validate_module_path(local_std_attack);
    assert(result.is_err(), "Local path attempting to shadow std:: must be rejected");
    seeAm("PASS: test_std_prefix_not_shadowed_by_local");
}

fn test_package_name_cannot_be_stdlib_path() {
    // A package at path "./std" should not be loadable via std:: syntax
    // The resolver must use the canonical stdlib root, not local directories
    mut safe = is_safe_path("std/math/mod.ov");
    assert(safe, "Canonical stdlib path must be safe");
    mut unsafe_shadow = is_safe_path("../std/math/mod.ov");
    assert(!unsafe_shadow, "Traversal to shadow stdlib must be unsafe");
    seeAm("PASS: test_package_name_cannot_be_stdlib_path");
}

// ============================================================
// Documentation Sanitization Tests
// ============================================================

fn test_sanitize_strips_script_tag() {
    mut raw = "Description <script>alert('xss')</script> end";
    mut safe = sanitize_doc_content(raw);
    assert(!string_contains(safe, "<script>"), "Script tag must be stripped");
    assert(!string_contains(safe, "</script>"), "Closing script tag must be stripped");
    assert(string_contains(safe, "Description"), "Text content must be preserved");
    seeAm("PASS: test_sanitize_strips_script_tag");
}

fn test_sanitize_strips_html_tags() {
    mut raw = "This is <b>bold</b> and <i>italic</i> text";
    mut safe = sanitize_doc_content(raw);
    assert(!string_contains(safe, "<b>"), "Bold tag must be stripped");
    assert(!string_contains(safe, "</b>"), "Closing bold tag must be stripped");
    assert(string_contains(safe, "bold"), "Text inside tags must be preserved");
    seeAm("PASS: test_sanitize_strips_html_tags");
}

fn test_sanitize_preserves_code_blocks() {
    mut raw = "Use ```\nfn foo<T>() {}\n``` for generics";
    mut safe = sanitize_doc_content(raw);
    assert(string_contains(safe, "fn foo<T>()"), "Code block content must be preserved unchanged");
    seeAm("PASS: test_sanitize_preserves_code_blocks");
}

fn test_sanitize_plain_text_unchanged() {
    mut raw = "This is plain text with no HTML";
    mut safe = sanitize_doc_content(raw);
    assert(safe == raw, "Plain text must pass through unchanged");
    seeAm("PASS: test_sanitize_plain_text_unchanged");
}

fn test_contains_html_detects_tags() {
    assert(contains_html("<b>bold</b>"), "Must detect HTML tags");
    assert(contains_html("<script>alert(1)</script>"), "Must detect script tags");
    assert(!contains_html("plain text"), "Must not flag plain text");
    assert(!contains_html("a < b and b > a"), "Must not flag comparison operators without closing tag");
    seeAm("PASS: test_contains_html_detects_tags");
}

// ============================================================
// Run All Security Tests
// ============================================================

fn run_all_security_tests() {
    seeAm("=== Security Tests ===");

    seeAm("-- Path Traversal Tests --");
    test_path_traversal_unix_absolute();
    test_path_traversal_dotdot_prefix();
    test_path_traversal_dotdot_middle();
    test_path_traversal_dotdot_suffix();
    test_path_traversal_standalone_dotdot();
    test_path_traversal_url_encoded();
    test_path_traversal_windows_absolute();
    test_safe_relative_path();
    test_safe_dot_relative_path();
    test_safe_nested_path();
    test_non_ov_extension_rejected();

    seeAm("-- Cache Integrity Tests --");
    test_artifact_hash_is_deterministic();
    test_artifact_hash_changes_on_content_change();
    test_artifact_hash_changes_on_path_change();

    seeAm("-- Dependency Confusion Tests --");
    test_std_prefix_not_shadowed_by_local();
    test_package_name_cannot_be_stdlib_path();

    seeAm("-- Documentation Sanitization Tests --");
    test_sanitize_strips_script_tag();
    test_sanitize_strips_html_tags();
    test_sanitize_preserves_code_blocks();
    test_sanitize_plain_text_unchanged();
    test_contains_html_detects_tags();

    seeAm("=== All security tests passed ===");
}

run_all_security_tests();
