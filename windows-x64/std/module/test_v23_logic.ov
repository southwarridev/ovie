// v2.3 Module System — Compatibility Test Suite
// Tests the logic of all module system components using v2.2-compatible syntax
// These tests validate the algorithms that the v2.3 .ov files implement

fn assert_true(cond, msg) {
    if cond {
        seeAm "PASS: " + msg
    } else {
        seeAm "FAIL: " + msg
    }
}

fn assert_false(cond, msg) {
    if !cond {
        seeAm "PASS: " + msg
    } else {
        seeAm "FAIL: " + msg
    }
}

fn assert_eq(a, b, msg) {
    if a == b {
        seeAm "PASS: " + msg
    } else {
        seeAm "FAIL: " + msg + " (got " + a + ")"
    }
}

seeAm "================================================"
seeAm "  Ovie v2.3 Module System — Logic Test Suite"
seeAm "================================================"

// ============================================================
// 1. PATH TRAVERSAL SECURITY (security.ov logic)
// ============================================================
seeAm ""
seeAm "--- 1. Path Traversal Security ---"

fn is_safe_path(path) {
    if path.starts_with("/") { return false }
    if path.contains(":/") { return false }
    if path.starts_with("../") { return false }
    if path.contains("/../") { return false }
    if path == ".." { return false }
    if path.contains("%2e%2e") { return false }
    if path.contains("%2f") { return false }
    if !path.ends_with(".ov") { return false }
    return true
}

assert_false(is_safe_path("/etc/passwd.ov"), "Unix absolute path rejected")
assert_false(is_safe_path("../../../etc/passwd.ov"), "dotdot prefix rejected")
assert_false(is_safe_path("std/../../secret.ov"), "dotdot middle rejected")
assert_false(is_safe_path(".."), "standalone dotdot rejected")
assert_false(is_safe_path("std/%2e%2e/secret.ov"), "URL-encoded traversal rejected")
assert_false(is_safe_path("C:/Windows/secret.ov"), "Windows absolute path rejected")
assert_true(is_safe_path("std/math/mod.ov"), "safe relative path accepted")
assert_true(is_safe_path("./utils.ov"), "dot-relative path accepted")
assert_true(is_safe_path("src/modules/parser.ov"), "nested safe path accepted")
assert_false(is_safe_path("std/math/mod.rs"), "non-.ov extension rejected")

// ============================================================
// 2. DOCUMENTATION SANITIZATION (security.ov logic)
// ============================================================
seeAm ""
seeAm "--- 2. Documentation Sanitization ---"

fn contains_html(doc) {
    if doc.contains("<script>") { return true }
    if doc.contains("<b>") { return true }
    if doc.contains("<i>") { return true }
    if doc.contains("<div>") { return true }
    if doc.contains("<span>") { return true }
    return false
}

assert_true(contains_html("This is <b>bold</b>"), "HTML bold tag detected")
assert_true(contains_html("<script>alert(1)</script>"), "Script tag detected")
assert_false(contains_html("Plain text with no HTML"), "Plain text not flagged")
assert_false(contains_html("a < b and b > a"), "Comparison operators not flagged")

// ============================================================
// 3. HASH DETERMINISM (performance.ov logic)
// ============================================================
seeAm ""
seeAm "--- 3. Hash Determinism ---"

fn djb2_hash(s) {
    mut h = 5381
    mut i = 0
    while i < s.len() {
        h = (h * 33) + i + 1
        i = i + 1
    }
    return h
}

mut h1 = djb2_hash("std/math/mod.ov")
mut h2 = djb2_hash("std/math/mod.ov")
mut h3 = djb2_hash("std/io/mod.ov")

assert_eq(h1, h2, "Hash is deterministic for same input")
assert_true(h1 != h3, "Different paths produce different hashes")

fn seeded_hash(path, content) {
    return djb2_hash(path) + djb2_hash(content) * 31
}
mut sh1 = seeded_hash("std/math/mod.ov", "export fn add() {}")
mut sh2 = seeded_hash("src/utils/mod.ov", "export fn add() {}")
assert_true(sh1 != sh2, "Same content at different paths produces different hashes")

// ============================================================
// 4. DEPENDENCY GRAPH (dependency_graph.ov logic)
// ============================================================
seeAm ""
seeAm "--- 4. Dependency Graph ---"

// Topological sort: nodes with no deps come first
// Graph: main -> math, main -> io; math and io have no deps
// Expected: math and io before main

fn is_dep_of(module, dep, edges_from, edges_to, count) {
    mut i = 0
    while i < count {
        if edges_from[i] == module && edges_to[i] == dep {
            return true
        }
        i = i + 1
    }
    return false
}

mut from = ["main.ov", "main.ov"]
mut to = ["math.ov", "io.ov"]

assert_true(is_dep_of("main.ov", "math.ov", from, to, 2), "main depends on math")
assert_true(is_dep_of("main.ov", "io.ov", from, to, 2), "main depends on io")
assert_false(is_dep_of("math.ov", "main.ov", from, to, 2), "math does not depend on main")

// Cycle detection: A->B->A is a cycle
fn has_cycle(a_to_b, b_to_a) {
    return a_to_b && b_to_a
}
assert_true(has_cycle(true, true), "Mutual dependency is a cycle")
assert_false(has_cycle(true, false), "One-way dependency is not a cycle")
assert_false(has_cycle(false, false), "No dependency is not a cycle")

// Transitive deps: if A->B and B->C, then A transitively depends on C
fn has_transitive_dep(a_deps_b, b_deps_c) {
    return a_deps_b && b_deps_c
}
assert_true(has_transitive_dep(true, true), "Transitive dependency detected")
assert_false(has_transitive_dep(true, false), "No transitive dep when chain broken")

// ============================================================
// 5. CACHE VALIDITY (cache.ov logic)
// ============================================================
seeAm ""
seeAm "--- 5. Cache Validity ---"

fn is_cache_valid(stored_src_hash, stored_deps_hash, stored_version,
                  current_src_hash, current_deps_hash, current_version) {
    if stored_version != current_version { return false }
    if stored_src_hash != current_src_hash { return false }
    if stored_deps_hash != current_deps_hash { return false }
    return true
}

assert_true(is_cache_valid("abc", "def", "2.3.0", "abc", "def", "2.3.0"), "Valid cache entry accepted")
assert_false(is_cache_valid("abc", "def", "2.3.0", "xyz", "def", "2.3.0"), "Stale source hash invalidates cache")
assert_false(is_cache_valid("abc", "def", "2.3.0", "abc", "xyz", "2.3.0"), "Stale deps hash invalidates cache")
assert_false(is_cache_valid("abc", "def", "2.2.0", "abc", "def", "2.3.0"), "Version mismatch invalidates cache")

// ============================================================
// 6. MODULE PATH RESOLUTION (resolver.ov logic)
// ============================================================
seeAm ""
seeAm "--- 6. Module Path Resolution ---"

fn module_path_to_file(module_path) {
    // std::math -> std/math/mod.ov
    mut result = module_path.replace("::", "/")
    result = result + "/mod.ov"
    return result
}

assert_eq(module_path_to_file("std::math"), "std/math/mod.ov", "std::math resolves correctly")
assert_eq(module_path_to_file("std::io"), "std/io/mod.ov", "std::io resolves correctly")
assert_eq(module_path_to_file("oba::hypercomplex"), "oba/hypercomplex/mod.ov", "third-party resolves correctly")

// ============================================================
// 7. EXPORT VALIDATION (loader.ov logic)
// ============================================================
seeAm ""
seeAm "--- 7. Export Validation ---"

fn validate_export_name(name) {
    if name.len() == 0 { return false }
    if name.starts_with("_") { return false }
    return true
}

assert_true(validate_export_name("add"), "Valid export name accepted")
assert_true(validate_export_name("compute_hash"), "Snake case export accepted")
assert_false(validate_export_name(""), "Empty export name rejected")

fn is_valid_symbol_type(t) {
    if t == "function" { return true }
    if t == "type" { return true }
    if t == "constant" { return true }
    if t == "enum" { return true }
    return false
}

assert_true(is_valid_symbol_type("function"), "function is valid symbol type")
assert_true(is_valid_symbol_type("type"), "type is valid symbol type")
assert_true(is_valid_symbol_type("constant"), "constant is valid symbol type")
assert_true(is_valid_symbol_type("enum"), "enum is valid symbol type")
assert_false(is_valid_symbol_type("variable"), "variable is not a valid symbol type")
assert_false(is_valid_symbol_type(""), "empty string is not a valid symbol type")

// ============================================================
// 8. PACKAGE MANIFEST VALIDATION (package_manager.ov logic)
// ============================================================
seeAm ""
seeAm "--- 8. Package Manifest Validation ---"

fn is_valid_version(v) {
    // Simple check: must contain at least one dot
    return v.contains(".")
}

fn version_satisfies_constraint(version, constraint) {
    // Simplified: exact match or starts with >=
    if constraint.starts_with(">=") {
        return true  // simplified: assume satisfied
    }
    return version == constraint
}

assert_true(is_valid_version("1.0.0"), "1.0.0 is valid version")
assert_true(is_valid_version("2.3.0"), "2.3.0 is valid version")
assert_false(is_valid_version("1"), "1 is not a valid version (no dot)")
assert_true(version_satisfies_constraint("1.2.0", ">=1.0.0"), ">= constraint satisfied")
assert_true(version_satisfies_constraint("1.0.0", "1.0.0"), "exact version satisfied")
assert_false(version_satisfies_constraint("1.0.0", "2.0.0"), "wrong exact version rejected")

// ============================================================
// 9. DOCUMENTATION VALIDATION (documentation.ov logic)
// ============================================================
seeAm ""
seeAm "--- 9. Documentation Validation ---"

fn has_required_sections(doc) {
    if !doc.contains("# Parameters") && !doc.contains("# Returns") {
        return false
    }
    if !doc.contains("# Examples") {
        return false
    }
    return true
}

mut good_doc = "Brief description\n# Parameters\n- x: value\n# Returns\nresult\n# Examples\n```\nadd(1,2)\n```"
mut bad_doc = "Brief description only"

assert_true(has_required_sections(good_doc), "Complete doc comment accepted")
assert_false(has_required_sections(bad_doc), "Incomplete doc comment rejected")

// ============================================================
// 10. NAMESPACE COLLISION DETECTION (namespace.ov logic)
// ============================================================
seeAm ""
seeAm "--- 10. Namespace Collision Detection ---"

fn has_collision(sym1_module, sym1_name, sym2_module, sym2_name) {
    // Collision if same name from different modules
    if sym1_name == sym2_name && sym1_module != sym2_module {
        return true
    }
    return false
}

assert_true(has_collision("std::math", "sqrt", "my_math", "sqrt"), "Same name from different modules is collision")
assert_false(has_collision("std::math", "sqrt", "std::math", "sqrt"), "Same name from same module is not collision")
assert_false(has_collision("std::math", "sqrt", "std::math", "pow"), "Different names are not collision")

