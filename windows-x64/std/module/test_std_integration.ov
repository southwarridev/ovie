}

fn test_has_legacy_std_usage_math() {
    let src = "use math::{sin, cos};\nfn main() {}".to_string();
    assert(has_legacy_std_usage(&src), "use math:: should be detected as legacy");
    io::println("✓ test_has_legacy_std_usage_math passed");
}

fn test_has_legacy_std_usage_all_patterns() {
    let patterns = vec![
        "use time::{Duration};",
        "use env::{args};",
        "use cli::{App};",
        "use log::{info};",
        "use testing::{assert};"
    ];
    for src in patterns {
        assert(has_legacy_std_usage(&src.to_string()), "All legacy patterns should be detected");
    }
    io::println("✓ test_has_legacy_std_usage_all_patterns passed");
}

fn test_no_legacy_std_usage_modern() {
    let src = "use std::core::{Vec};\nfn main() {}".to_string();
    assert(!has_legacy_std_usage(&src), "Modern std:: usage should not be detected as legacy");
    io::println("✓ test_no_legacy_std_usage_modern passed");
}

fn test_no_legacy_std_usage_standalone() {
    let src = "fn main() { seeAm(\"hello\"); }".to_string();
    assert(!has_legacy_std_usage(&src), "Standalone file should not have legacy usage");
    io::println("✓ test_no_legacy_std_usage_standalone passed");
}

fn test_default_compat_mode_fields() {
    let mode = default_compat_mode();
    assert(mode.allow_implicit_std, "Default mode should allow implicit std");
    assert(mode.warn_on_legacy, "Default mode should warn on legacy");
    assert(!mode.lenient_exports, "Default mode should not have lenient exports");
    io::println("✓ test_default_compat_mode_fields passed");
}

fn test_strict_compat_mode_fields() {
    let mode = strict_compat_mode();
    assert(!mode.allow_implicit_std, "Strict mode should not allow implicit std");
    assert(!mode.warn_on_legacy, "Strict mode should not warn on legacy");
    assert(!mode.lenient_exports, "Strict mode should not have lenient exports");
    io::println("✓ test_strict_compat_mode_fields passed");
}

fn test_load_with_compat_standalone_sets_is_standalone() {
    let src = "fn main() { seeAm(\"hello\"); }".to_string();
    match load_with_compat("test_standalone.ov".to_string(), src) {
        Ok(module) => {
            assert(module.is_standalone, "Standalone source should set is_standalone=true");
            io::println("✓ test_load_with_compat_standalone_sets_is_standalone passed");
        },
        Err(e) => io::println("✗ test_load_with_compat_standalone_sets_is_standalone failed: {}", e)
    }
}

fn test_load_with_compat_modular_not_standalone() {
