fn test_is_cache_valid_max_age_expired() {
    let mut config = default_cache_config("2.3.0".to_string());
    config.max_age_seconds = 60;
    let mut cache = new_cache(config);
    let src_hash = "src_hash".to_string();
    let deps_hash = "deps_hash".to_string();
    let _ = cache_module(&mut cache, &"src/d.ov".to_string(),
                          src_hash.clone(), deps_hash.clone(),
                          &"artifact".to_string(), 1000);
    let valid = is_cache_valid(&cache, &"src/d.ov".to_string(),
                               &src_hash, &deps_hash, 2000);
    assert(!valid, "Expired cache entry should be invalid");
    io::println("✓ test_is_cache_valid_max_age_expired passed");
}

fn test_is_cache_valid_within_max_age() {
    let mut config = default_cache_config("2.3.0".to_string());
    config.max_age_seconds = 3600;
    let mut cache = new_cache(config);
    let src_hash = "src_hash".to_string();
    let deps_hash = "deps_hash".to_string();
    let _ = cache_module(&mut cache, &"src/e.ov".to_string(),
                          src_hash.clone(), deps_hash.clone(),
                          &"artifact".to_string(), 1000);
    let valid = is_cache_valid(&cache, &"src/e.ov".to_string(),
                               &src_hash, &deps_hash, 1100);
    assert(valid, "Cache within max age should be valid");
    io::println("✓ test_is_cache_valid_within_max_age passed");
}

fn test_invalidate_removes_entry() {
    let config = default_cache_config("2.3.0".to_string());
    let mut cache = new_cache(config);
    let _ = cache_module(&mut cache, &"src/f.ov".to_string(),
                          "src_hash".to_string(), "deps_hash".to_string(),
                          &"artifact".to_string(), 0);
    assert(cache.entries.contains_key("src/f.ov"), "Entry should exist before invalidate");
    invalidate(&mut cache, &"src/f.ov".to_string());
    assert(!cache.entries.contains_key("src/f.ov"), "Entry should be removed after invalidate");
    io::println("✓ test_invalidate_removes_entry passed");
}

fn test_invalidate_nonexistent_is_noop() {
    let config = default_cache_config("2.3.0".to_string());
    let mut cache = new_cache(config);
    invalidate(&mut cache, &"nonexistent.ov".to_string());
    assert(true, "Invalidating nonexistent entry should be a no-op");
    io::println("✓ test_invalidate_nonexistent_is_noop passed");
}

fn test_clear_cache_removes_all_entries() {
    let config = default_cache_config("2.3.0".to_string());
    let mut cache = new_cache(config);
    let _ = cache_module(&mut cache, &"a.ov".to_string(), "h1".to_string(), "d1".to_string(), &"art1".to_string(), 0);
    let _ = cache_module(&mut cache, &"b.ov".to_string(), "h2".to_string(), "d2".to_string(), &"art2".to_string(), 0);
    let _ = cache_module(&mut cache, &"c.ov".to_string(), "h3".to_string(), "d3".to_string(), &"art3".to_string(), 0);
    assert(cache.entries.len() == 3, "Should have 3 entries before clear");
    clear_cache(&mut cache);
    assert(cache.entries.is_empty(), "Cache should be empty after clear");
    io::println("✓ test_clear_cache_removes_all_entries passed");
}

