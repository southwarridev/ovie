fn test_is_standalone_no_keywords() {
    let src = "fn main() { seeAm(\"hello\"); }".to_string();
    assert(is_standalone_file(&src), "File with no module keywords should be standalone");
    io::println("✓ test_is_standalone_no_keywords passed");
}

fn test_is_standalone_comments_only_before_fn() {
    let src = "// A comment\n// Another\nfn main() {}".to_string();
    assert(is_standalone_file(&src), "Comments before fn should still be standalone");
    io::println("✓ test_is_standalone_comments_only_before_fn passed");
}

fn test_is_standalone_blank_lines_ignored() {
    let src = "\n\n\nfn main() {}".to_string();
    assert(is_standalone_file(&src), "Blank lines should not affect standalone detection");
    io::println("✓ test_is_standalone_blank_lines_ignored passed");
}

fn test_is_standalone_multiline_no_module_keywords() {
    let src = "fn add(a: Number, b: Number) -> Number {\n    return a + b;\n}\n\nfn main() {\n    seeAm(add(1, 2));\n}".to_string();
    assert(is_standalone_file(&src), "Multi-function file without module keywords should be standalone");
    io::println("✓ test_is_standalone_multiline_no_module_keywords passed");
}

fn test_not_standalone_has_use() {
    let src = "use std::core::{Vec};\nfn main() {}".to_string();
    assert(!is_standalone_file(&src), "File with 'use' should not be standalone");
    io::println("✓ test_not_standalone_has_use passed");
}

fn test_not_standalone_has_import() {
    let src = "import \"./utils.ov\";\nfn main() {}".to_string();
    assert(!is_standalone_file(&src), "File with 'import' should not be standalone");
    io::println("✓ test_not_standalone_has_import passed");
}

fn test_not_standalone_has_export() {
    let src = "export fn add(a: Number, b: Number) -> Number { a + b }".to_string();
    assert(!is_standalone_file(&src), "File with 'export' should not be standalone");
    io::println("✓ test_not_standalone_has_export passed");
}

fn test_not_standalone_export_in_middle() {
    let src = "fn helper() {}\nexport fn public_fn() {}".to_string();
    assert(!is_standalone_file(&src), "File with export anywhere should not be standalone");
    io::println("✓ test_not_standalone_export_in_middle passed");
}

