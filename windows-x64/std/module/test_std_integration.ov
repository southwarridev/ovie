        Err(e) => io::println("✗ test_resolve_std_path_ok failed: {}", e)
    }
}

fn test_resolve_std_core_ok() {
    let config = default_config();
    let result = resolve("std::core".to_string(), config);
    match result {
        Ok(_) => io::println("✓ test_resolve_std_core_ok passed"),
        Err(e) => io::println("✗ test_resolve_std_core_ok failed: {}", e)
    }
}

fn test_resolve_relative_path_no_panic() {
    let config = default_config();
    let _ = resolve("./loader.ov".to_string(), config);
    assert(true, "resolve should not panic on relative path");
