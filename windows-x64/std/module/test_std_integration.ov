fn test_new_lazy_registry_empty() {
    let reg = new_lazy_registry();
    assert(reg.parsed.is_empty(), "New registry should have no parsed modules");
    assert(reg.pending.is_empty(), "New registry should have no pending modules");
    io::println("✓ test_new_lazy_registry_empty passed");
}

fn test_queue_module_adds_to_pending() {
    let mut reg = new_lazy_registry();
    queue_module(&mut reg, "std/math/mod.ov".to_string());
    assert(reg.pending.contains(&"std/math/mod.ov".to_string()), "Module should be in pending");
    io::println("✓ test_queue_module_adds_to_pending passed");
}

fn test_queue_module_idempotent() {
    let mut reg = new_lazy_registry();
    queue_module(&mut reg, "a.ov".to_string());
    queue_module(&mut reg, "a.ov".to_string());
    assert(reg.pending.len() == 1, "Duplicate queue should be idempotent");
    io::println("✓ test_queue_module_idempotent passed");
}

fn test_is_parsed_false_initially() {
    let reg = new_lazy_registry();
    assert(!is_parsed(&reg, &"a.ov".to_string()), "Module should not be parsed initially");
    io::println("✓ test_is_parsed_false_initially passed");
}

fn test_is_parsed_true_after_get_or_parse() {
    let mut reg = new_lazy_registry();
    let source = "export fn hello() -> String { \"hi\".to_string() }".to_string();
    let _ = get_or_parse(&mut reg, &"hello.ov".to_string(), source);
    assert(is_parsed(&reg, &"hello.ov".to_string()), "Module should be parsed after get_or_parse");
    io::println("✓ test_is_parsed_true_after_get_or_parse passed");
}

fn test_get_or_parse_returns_same_module_twice() {
    let mut reg = new_lazy_registry();
    let source = "export fn greet() -> String { \"hello\".to_string() }".to_string();
    match get_or_parse(&mut reg, &"greet.ov".to_string(), source.clone()) {
        Ok(m1) => {
            match get_or_parse(&mut reg, &"greet.ov".to_string(), source) {
                Ok(m2) => {
                    assert(m1.path == m2.path, "Same path should be returned");
                    assert(m1.source_hash == m2.source_hash, "Same hash should be returned");
                    io::println("✓ test_get_or_parse_returns_same_module_twice passed");
                },
                Err(e) => io::println("✗ test_get_or_parse_returns_same_module_twice failed: {}", e)
            }
        },
        Err(e) => io::println("✗ test_get_or_parse_returns_same_module_twice failed: {}", e)
    }
}

fn test_get_or_parse_removes_from_pending() {
    let mut reg = new_lazy_registry();
    queue_module(&mut reg, "queued.ov".to_string());
    assert(reg.pending.contains(&"queued.ov".to_string()), "Should be in pending before parse");
    let _ = get_or_parse(&mut reg, &"queued.ov".to_string(), "fn main() {}".to_string());
    assert(!reg.pending.contains(&"queued.ov".to_string()), "Should be removed from pending after parse");
    io::println("✓ test_get_or_parse_removes_from_pending passed");
}

// ============================================================
// SECTION 6: cache.ov — identify_load_levels
// ============================================================

fn test_identify_load_levels_no_deps_all_level_zero() {
    let mut g = new_graph();
    add_module(&mut g, "a.ov".to_string());
    add_module(&mut g, "b.ov".to_string());
    add_module(&mut g, "c.ov".to_string());
    let levels = identify_load_levels(&g);
    assert(!levels.is_empty(), "Should have at least one level");
    assert(!levels[0].modules.is_empty(), "Level 0 should have modules");
    assert(levels[0].level == 0, "First level should be 0");
    io::println("✓ test_identify_load_levels_no_deps_all_level_zero passed");
}

fn test_identify_load_levels_linear_chain() {
    let mut g = new_graph();
    add_dependency(&mut g, "c.ov".to_string(), "b.ov".to_string());
    add_dependency(&mut g, "b.ov".to_string(), "a.ov".to_string());
    let levels = identify_load_levels(&g);
    assert(levels.len() >= 3, "Linear chain should have 3 levels");
    assert(levels[0].modules.contains(&"a.ov".to_string()), "a.ov should be at level 0");
    assert(levels[1].modules.contains(&"b.ov".to_string()), "b.ov should be at level 1");
    assert(levels[2].modules.contains(&"c.ov".to_string()), "c.ov should be at level 2");
    io::println("✓ test_identify_load_levels_linear_chain passed");
}

fn test_identify_load_levels_cycle_returns_empty() {
    let mut g = new_graph();
    add_dependency(&mut g, "x.ov".to_string(), "y.ov".to_string());
    add_dependency(&mut g, "y.ov".to_string(), "x.ov".to_string());
    let levels = identify_load_levels(&g);
    assert(levels.is_empty(), "Cyclic graph should return empty levels");
    io::println("✓ test_identify_load_levels_cycle_returns_empty passed");
}

fn test_identify_load_levels_diamond() {
    let mut g = new_graph();
    add_dependency(&mut g, "root.ov".to_string(), "left.ov".to_string());
    add_dependency(&mut g, "root.ov".to_string(), "right.ov".to_string());
    add_dependency(&mut g, "left.ov".to_string(), "leaf.ov".to_string());
    add_dependency(&mut g, "right.ov".to_string(), "leaf.ov".to_string());
    let levels = identify_load_levels(&g);
    assert(levels.len() >= 3, "Diamond should have at least 3 levels");
    assert(levels[0].modules.contains(&"leaf.ov".to_string()), "leaf.ov should be at level 0");
    io::println("✓ test_identify_load_levels_diamond passed");
}

