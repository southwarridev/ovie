/// Integration Tests — std:: Module Usage (Task 19.1)
///
/// Covers every component implemented across all phases:
///   Phase 1: types.ov
///   Phase 2: loader.ov
///   Phase 3: resolver.ov, dependency_graph.ov, cache.ov
///   Phase 4: migrate.ov, fs_integration.ov, backward compat layer

use std::io;
use std::core::{Vec, HashMap, Option, Result};
use ./types::{Module, Import, ExportTable, ModuleError,
              FunctionSignature, Parameter, Type, TypeDefinition,
              TypeKind, Field, ConstantInfo, EnumDefinition, EnumVariant};
use ./resolver::{default_config, resolve, path_to_file,
                 normalize_path, is_valid_module, search_paths};
use ./dependency_graph::{new_graph, add_module, add_dependency,
                          topological_sort, detect_cycles,
                          get_transitive_deps, update_module_deps,
                          find_shortest_cycle, format_cycle_error};
use ./cache::{new_cache, default_cache_config, compute_source_hash,
              compute_dependencies_hash, is_cache_valid, cache_module,
              get_cached, invalidate, clear_cache,
              new_lazy_registry, queue_module, get_or_parse, is_parsed,
              identify_load_levels};
use ./migrate::{default_migrate_config, analyze_used_symbols,
                generate_ovie_toml, migrate_file};
use ./fs_integration::{join_path, parent_dir, filename, extension};
use ./loader::{is_loaded, load_with_compat, is_standalone_file,
               has_legacy_std_usage, is_legacy_module,
               default_compat_mode, strict_compat_mode, load_with_mode};

// ============================================================
// SECTION 1: types.ov — data structure construction
// ============================================================

fn test_module_type_fields() {
    let m = Module {
        path: "src/main.ov".to_string(),
        name: "main".to_string(),
        exports: ExportTable {
            functions: HashMap::new(),
            types: HashMap::new(),
            constants: HashMap::new(),
            enums: HashMap::new()
        },
        imports: Vec::new(),
        source_hash: "abc123".to_string(),
        compiled_at: 0,
        doc_comments: HashMap::new(),
        is_standalone: false
    };
    assert(m.path == "src/main.ov".to_string(), "Module path should match");
    assert(m.name == "main".to_string(), "Module name should match");
    assert(!m.is_standalone, "Module should not be standalone");
    assert(m.imports.is_empty(), "Module imports should be empty");
    io::println("✓ test_module_type_fields passed");
}

fn test_import_type_fields() {
    let imp = Import {
        module_path: "std::math".to_string(),
        symbols: Some(vec!["sin".to_string(), "cos".to_string()]),
        alias: None
    };
    assert(imp.module_path == "std::math".to_string(), "Import path should match");
    match imp.symbols {
        Some(syms) => assert(syms.len() == 2, "Should have 2 symbols"),
        None => assert(false, "Symbols should be Some")
    }
    match imp.alias {
        None => io::println("✓ test_import_type_fields passed"),
        Some(_) => assert(false, "Alias should be None")
    }
}

fn test_import_wildcard() {
    let imp = Import {
        module_path: "std::core".to_string(),
        symbols: None,
        alias: None
    };
    match imp.symbols {
        None => io::println("✓ test_import_wildcard passed"),
        Some(_) => assert(false, "Wildcard import should have None symbols")
    }
}

fn test_import_with_alias() {
    let imp = Import {
        module_path: "std::math".to_string(),
        symbols: None,
        alias: Some("math".to_string())
    };
    match imp.alias {
        Some(a) => {
            assert(a == "math".to_string(), "Alias should be 'math'");
            io::println("✓ test_import_with_alias passed");
        },
        None => assert(false, "Alias should be Some")
    }
}

fn test_export_table_empty() {
    let et = ExportTable {
        functions: HashMap::new(),
        types: HashMap::new(),
        constants: HashMap::new(),
        enums: HashMap::new()
    };
    assert(et.functions.is_empty(), "Functions should be empty");
    assert(et.types.is_empty(), "Types should be empty");
    assert(et.constants.is_empty(), "Constants should be empty");
    assert(et.enums.is_empty(), "Enums should be empty");
    io::println("✓ test_export_table_empty passed");
}

fn test_function_signature_fields() {
    let sig = FunctionSignature {
        name: "add".to_string(),
        parameters: vec![
            Parameter {
                name: "a".to_string(),
                param_type: Type { name: "Number".to_string(), is_generic: false, type_params: Vec::new() },
                is_mutable: false
            },
            Parameter {
                name: "b".to_string(),
                param_type: Type { name: "Number".to_string(), is_generic: false, type_params: Vec::new() },
                is_mutable: false
            }
        ],
        return_type: Type { name: "Number".to_string(), is_generic: false, type_params: Vec::new() },
        doc_comment: "Adds two numbers".to_string(),
        is_generic: false
    };
    assert(sig.name == "add".to_string(), "Function name should be 'add'");
    assert(sig.parameters.len() == 2, "Should have 2 parameters");
    assert(sig.return_type.name == "Number".to_string(), "Return type should be Number");
    assert(!sig.is_generic, "Should not be generic");
    io::println("✓ test_function_signature_fields passed");
}

fn test_type_definition_struct_kind() {
    let td = TypeDefinition {
        name: "Point".to_string(),
        kind: TypeKind::Struct,
        fields: vec![
            Field { name: "x".to_string(), field_type: Type { name: "Number".to_string(), is_generic: false, type_params: Vec::new() }, is_public: true },
            Field { name: "y".to_string(), field_type: Type { name: "Number".to_string(), is_generic: false, type_params: Vec::new() }, is_public: true }
        ],
        doc_comment: "A 2D point".to_string()
    };
    assert(td.name == "Point".to_string(), "Type name should be 'Point'");
    assert(td.fields.len() == 2, "Should have 2 fields");
    assert(td.fields[0].name == "x".to_string(), "First field should be 'x'");
    io::println("✓ test_type_definition_struct_kind passed");
}

fn test_constant_info_fields() {
    let ci = ConstantInfo {
        name: "MAX_SIZE".to_string(),
        const_type: Type { name: "Number".to_string(), is_generic: false, type_params: Vec::new() },
        value: "1024".to_string(),
        doc_comment: "Maximum buffer size".to_string()
    };
    assert(ci.name == "MAX_SIZE".to_string(), "Constant name should match");
    assert(ci.value == "1024".to_string(), "Constant value should match");
    io::println("✓ test_constant_info_fields passed");
}

fn test_enum_definition_fields() {
    let ed = EnumDefinition {
        name: "Color".to_string(),
        variants: vec![
            EnumVariant { name: "Red".to_string(), fields: None },
            EnumVariant { name: "Green".to_string(), fields: None },
            EnumVariant { name: "Blue".to_string(), fields: None }
        ],
        doc_comment: "RGB colors".to_string()
    };
    assert(ed.name == "Color".to_string(), "Enum name should be 'Color'");
    assert(ed.variants.len() == 3, "Should have 3 variants");
    assert(ed.variants[0].name == "Red".to_string(), "First variant should be 'Red'");
    io::println("✓ test_enum_definition_fields passed");
}

fn test_module_error_variants() {
    let _e1 = ModuleError::NotFound("missing.ov".to_string());
    let _e2 = ModuleError::ParseError("bad syntax".to_string());
    let _e3 = ModuleError::ExportError("no such symbol".to_string());
    let _e4 = ModuleError::ImportError("unresolved".to_string());
    let _e5 = ModuleError::CircularDependency(vec!["a.ov".to_string(), "b.ov".to_string()]);
    let _e6 = ModuleError::SymbolNotFound("foo".to_string());
    let _e7 = ModuleError::NameCollision("bar".to_string());
    assert(true, "All error variants should be constructable");
    io::println("✓ test_module_error_variants passed");
}

