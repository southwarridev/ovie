// ============================================================
// SECTION 3: dependency_graph.ov
// ============================================================

fn test_new_graph_is_empty() {
    let g = new_graph();
    assert(g.nodes.is_empty(), "New graph should have no nodes");
    assert(g.edges.is_empty(), "New graph should have no edges");
    io::println("✓ test_new_graph_is_empty passed");
}

fn test_add_module_creates_node() {
    let mut g = new_graph();
    add_module(&mut g, "a.ov".to_string());
    assert(g.nodes.contains_key("a.ov"), "Node 'a.ov' should exist");
    assert(g.nodes.len() == 1, "Should have exactly 1 node");
    io::println("✓ test_add_module_creates_node passed");
}

fn test_add_module_idempotent() {
    let mut g = new_graph();
    add_module(&mut g, "a.ov".to_string());
    add_module(&mut g, "a.ov".to_string());
    assert(g.nodes.len() == 1, "Duplicate add_module should be idempotent");
    io::println("✓ test_add_module_idempotent passed");
}

fn test_add_dependency_creates_both_nodes() {
    let mut g = new_graph();
    add_dependency(&mut g, "main.ov".to_string(), "utils.ov".to_string());
    assert(g.nodes.contains_key("main.ov"), "main.ov node should exist");
    assert(g.nodes.contains_key("utils.ov"), "utils.ov node should exist");
    assert(g.edges.len() == 1, "Should have 1 edge");
    io::println("✓ test_add_dependency_creates_both_nodes passed");
}

fn test_add_dependency_idempotent() {
    let mut g = new_graph();
    add_dependency(&mut g, "a.ov".to_string(), "b.ov".to_string());
    add_dependency(&mut g, "a.ov".to_string(), "b.ov".to_string());
    assert(g.edges.len() == 1, "Duplicate dependency should be idempotent");
    io::println("✓ test_add_dependency_idempotent passed");
}

fn test_add_dependency_updates_adjacency() {
    let mut g = new_graph();
    add_dependency(&mut g, "a.ov".to_string(), "b.ov".to_string());
    match g.nodes.get("a.ov") {
        Some(a_node) => assert(a_node.dependencies.contains(&"b.ov".to_string()), "a.ov should depend on b.ov"),
        None => assert(false, "a.ov node should exist")
    }
    match g.nodes.get("b.ov") {
        Some(b_node) => assert(b_node.dependents.contains(&"a.ov".to_string()), "b.ov should have a.ov as dependent"),
        None => assert(false, "b.ov node should exist")
    }
    io::println("✓ test_add_dependency_updates_adjacency passed");
}

fn test_topological_sort_linear_chain() {
    let mut g = new_graph();
    add_dependency(&mut g, "c.ov".to_string(), "b.ov".to_string());
    add_dependency(&mut g, "b.ov".to_string(), "a.ov".to_string());
    match topological_sort(&g) {
        Ok(order) => {
            let a_pos = order.iter().position(|x| x == "a.ov").unwrap();
            let b_pos = order.iter().position(|x| x == "b.ov").unwrap();
            let c_pos = order.iter().position(|x| x == "c.ov").unwrap();
            assert(a_pos < b_pos, "a.ov should come before b.ov");
            assert(b_pos < c_pos, "b.ov should come before c.ov");
            io::println("✓ test_topological_sort_linear_chain passed");
        },
        Err(_) => assert(false, "Linear chain should not have cycles")
    }
}

fn test_topological_sort_single_node() {
    let mut g = new_graph();
    add_module(&mut g, "solo.ov".to_string());
    match topological_sort(&g) {
        Ok(order) => {
            assert(order.len() == 1, "Single node should produce order of length 1");
            assert(order[0] == "solo.ov".to_string(), "Single node should be solo.ov");
            io::println("✓ test_topological_sort_single_node passed");
        },
        Err(_) => assert(false, "Single node should not have cycles")
    }
}

fn test_topological_sort_cycle_returns_err() {
    let mut g = new_graph();
    add_dependency(&mut g, "x.ov".to_string(), "y.ov".to_string());
    add_dependency(&mut g, "y.ov".to_string(), "x.ov".to_string());
    match topological_sort(&g) {
        Ok(_) => assert(false, "Cycle should return Err"),
        Err(_) => io::println("✓ test_topological_sort_cycle_returns_err passed")
    }
}

fn test_detect_cycles_acyclic_returns_none() {
    let mut g = new_graph();
    add_dependency(&mut g, "b.ov".to_string(), "a.ov".to_string());
    match detect_cycles(&g) {
        None => io::println("✓ test_detect_cycles_acyclic_returns_none passed"),
        Some(_) => assert(false, "Acyclic graph should return None")
    }
}

fn test_detect_cycles_cyclic_returns_some() {
    let mut g = new_graph();
    add_dependency(&mut g, "a.ov".to_string(), "b.ov".to_string());
    add_dependency(&mut g, "b.ov".to_string(), "c.ov".to_string());
    add_dependency(&mut g, "c.ov".to_string(), "a.ov".to_string());
    match detect_cycles(&g) {
        Some(cycle) => {
            assert(!cycle.cycle_path.is_empty(), "Cycle path should not be empty");
            io::println("✓ test_detect_cycles_cyclic_returns_some passed");
        },
        None => assert(false, "Cyclic graph should return Some")
    }
}

fn test_get_transitive_deps_direct_only() {
    let mut g = new_graph();
    add_dependency(&mut g, "main.ov".to_string(), "utils.ov".to_string());
    let deps = get_transitive_deps(&g, &"main.ov".to_string());
    assert(deps.contains(&"utils.ov".to_string()), "Should contain utils.ov");
    assert(deps.len() == 1, "Should have exactly 1 dep");
    io::println("✓ test_get_transitive_deps_direct_only passed");
}

fn test_get_transitive_deps_multi_level() {
    let mut g = new_graph();
    add_dependency(&mut g, "root.ov".to_string(), "mid.ov".to_string());
    add_dependency(&mut g, "mid.ov".to_string(), "leaf.ov".to_string());
    let deps = get_transitive_deps(&g, &"root.ov".to_string());
    assert(deps.contains(&"mid.ov".to_string()), "Should contain mid.ov");
    assert(deps.contains(&"leaf.ov".to_string()), "Should contain leaf.ov");
    io::println("✓ test_get_transitive_deps_multi_level passed");
}

fn test_get_transitive_deps_no_deps() {
    let mut g = new_graph();
    add_module(&mut g, "standalone.ov".to_string());
    let deps = get_transitive_deps(&g, &"standalone.ov".to_string());
    assert(deps.is_empty(), "Standalone module should have no deps");
    io::println("✓ test_get_transitive_deps_no_deps passed");
}

fn test_get_transitive_deps_diamond_no_duplicates() {
    let mut g = new_graph();
    add_dependency(&mut g, "root.ov".to_string(), "left.ov".to_string());
    add_dependency(&mut g, "root.ov".to_string(), "right.ov".to_string());
    add_dependency(&mut g, "left.ov".to_string(), "shared.ov".to_string());
    add_dependency(&mut g, "right.ov".to_string(), "shared.ov".to_string());
    let deps = get_transitive_deps(&g, &"root.ov".to_string());
    let count = deps.iter().filter(|d| *d == "shared.ov").count();
    assert(count == 1, "shared.ov should appear exactly once");
    io::println("✓ test_get_transitive_deps_diamond_no_duplicates passed");
}

fn test_update_module_deps_replaces_old() {
    let mut g = new_graph();
    add_dependency(&mut g, "main.ov".to_string(), "old_dep.ov".to_string());
    update_module_deps(&mut g, &"main.ov".to_string(), vec!["new_dep.ov".to_string()]);
    match g.nodes.get("main.ov") {
        Some(node) => {
            assert(!node.dependencies.contains(&"old_dep.ov".to_string()), "old_dep should be removed");
            assert(node.dependencies.contains(&"new_dep.ov".to_string()), "new_dep should be added");
            io::println("✓ test_update_module_deps_replaces_old passed");
        },
        None => assert(false, "main.ov node should exist")
    }
}

fn test_update_module_deps_clears_all() {
    let mut g = new_graph();
    add_dependency(&mut g, "main.ov".to_string(), "a.ov".to_string());
    add_dependency(&mut g, "main.ov".to_string(), "b.ov".to_string());
    update_module_deps(&mut g, &"main.ov".to_string(), Vec::new());
    match g.nodes.get("main.ov") {
        Some(node) => {
            assert(node.dependencies.is_empty(), "All deps should be cleared");
            io::println("✓ test_update_module_deps_clears_all passed");
        },
        None => assert(false, "main.ov node should exist")
    }
}

fn test_format_cycle_error_contains_cycle_path() {
    let mut g = new_graph();
    add_dependency(&mut g, "a.ov".to_string(), "b.ov".to_string());
    add_dependency(&mut g, "b.ov".to_string(), "a.ov".to_string());
    match detect_cycles(&g) {
        Some(cycle) => {
            let msg = format_cycle_error(&cycle);
            assert(!msg.is_empty(), "Error message should not be empty");
            io::println("✓ test_format_cycle_error_contains_cycle_path passed");
        },
        None => assert(false, "Should detect cycle")
    }
}

fn test_find_shortest_cycle_returns_cycle() {
    let mut g = new_graph();
    add_dependency(&mut g, "a.ov".to_string(), "b.ov".to_string());
    add_dependency(&mut g, "b.ov".to_string(), "a.ov".to_string());
    match detect_cycles(&g) {
        Some(cycle) => {
            let shortest = find_shortest_cycle(&g, &cycle);
            assert(!shortest.is_empty(), "Shortest cycle should not be empty");
            assert(shortest.len() >= 2, "Shortest cycle should have at least 2 nodes");
            io::println("✓ test_find_shortest_cycle_returns_cycle passed");
        },
        None => assert(false, "Should detect cycle")
    }
}

// ============================================================
// SECTION 4: cache.ov — hashing, validity, store/retrieve
// ============================================================

fn test_compute_source_hash_deterministic() {
    let src = "fn main() { seeAm(\"hello\"); }".to_string();
    let h1 = compute_source_hash(&src);
    let h2 = compute_source_hash(&src);
    assert(h1 == h2, "Same source should produce same hash");
    io::println("✓ test_compute_source_hash_deterministic passed");
}

fn test_compute_source_hash_different_inputs() {
    let h1 = compute_source_hash(&"fn a() {}".to_string());
    let h2 = compute_source_hash(&"fn b() {}".to_string());
    assert(h1 != h2, "Different sources should produce different hashes");
    io::println("✓ test_compute_source_hash_different_inputs passed");
}

fn test_compute_source_hash_empty_string() {
    let h = compute_source_hash(&"".to_string());
    assert(!h.is_empty(), "Hash of empty string should not be empty");
    io::println("✓ test_compute_source_hash_empty_string passed");
}

fn test_compute_dependencies_hash_deterministic() {
    let deps = vec![
        ("a.ov".to_string(), "hash_a".to_string()),
        ("b.ov".to_string(), "hash_b".to_string())
    ];
    let h1 = compute_dependencies_hash(&deps);
    let h2 = compute_dependencies_hash(&deps);
    assert(h1 == h2, "Same deps should produce same hash");
    io::println("✓ test_compute_dependencies_hash_deterministic passed");
}

fn test_compute_dependencies_hash_order_independent() {
    let deps1 = vec![
        ("a.ov".to_string(), "hash_a".to_string()),
        ("b.ov".to_string(), "hash_b".to_string())
    ];
    let deps2 = vec![
        ("b.ov".to_string(), "hash_b".to_string()),
        ("a.ov".to_string(), "hash_a".to_string())
    ];
    assert(compute_dependencies_hash(&deps1) == compute_dependencies_hash(&deps2),
           "Hash should be order-independent");
    io::println("✓ test_compute_dependencies_hash_order_independent passed");
}

fn test_compute_dependencies_hash_empty() {
    let h = compute_dependencies_hash(&Vec::new());
    assert(!h.is_empty(), "Hash of empty deps should not be empty");
    io::println("✓ test_compute_dependencies_hash_empty passed");
}

fn test_new_cache_starts_empty() {
    let config = default_cache_config("2.3.0".to_string());
    let cache = new_cache(config);
    assert(cache.entries.is_empty(), "New cache should be empty");
    io::println("✓ test_new_cache_starts_empty passed");
}

fn test_default_cache_config_fields() {
    let config = default_cache_config("2.3.0".to_string());
    assert(config.compiler_version == "2.3.0".to_string(), "Compiler version should match");
    assert(config.cache_dir == ".ovie/cache".to_string(), "Cache dir should be .ovie/cache");
    assert(config.max_age_seconds == 0, "Default max age should be 0");
