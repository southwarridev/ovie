    let t2 = generate_ovie_toml(&"app_two".to_string(), &"0.1.0".to_string());
    assert(t1 != t2, "Different names should produce different TOMLs");
    assert(t1.contains("app_one"), "t1 should contain app_one");
    assert(t2.contains("app_two"), "t2 should contain app_two");
