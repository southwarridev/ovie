fn test_is_cache_valid_miss_on_empty_cache() {
    let config = default_cache_config("2.3.0".to_string());
    let cache = new_cache(config);
    let valid = is_cache_valid(&cache, &"src/main.ov".to_string(),
                               &"hash1".to_string(), &"deps1".to_string(), 0);
    assert(!valid, "Empty cache should always be a miss");
    io::println("✓ test_is_cache_valid_miss_on_empty_cache passed");
}

fn test_cache_module_and_is_valid() {
    let config = default_cache_config("2.3.0".to_string());
    let mut cache = new_cache(config);
    let src_hash = compute_source_hash(&"fn main() {}".to_string());
    let deps_hash = compute_dependencies_hash(&Vec::new());
    match cache_module(&mut cache, &"src/main.ov".to_string(),
                       src_hash.clone(), deps_hash.clone(),
                       &"compiled_artifact".to_string(), 1000) {
        Ok(_) => {
            let valid = is_cache_valid(&cache, &"src/main.ov".to_string(),
                                       &src_hash, &deps_hash, 0);
            assert(valid, "Cache should be valid after storing");
            io::println("✓ test_cache_module_and_is_valid passed");
        },
        Err(e) => io::println("✗ test_cache_module_and_is_valid failed: {}", e)
    }
}

fn test_is_cache_valid_wrong_source_hash() {
