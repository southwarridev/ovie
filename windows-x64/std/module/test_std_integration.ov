fn test_resolver_and_dep_graph_together() {
    let config = default_config();
    match resolve("std::core".to_string(), config.clone()) {
        Ok(r1) => {
            match resolve("std::math".to_string(), config) {
                Ok(r2) => {
                    let mut g = new_graph();
                    add_module(&mut g, r1.absolute_path.clone());
                    add_module(&mut g, r2.absolute_path.clone());
                    assert(g.nodes.len() == 2, "Should have 2 nodes in graph");
                    io::println("✓ test_resolver_and_dep_graph_together passed");
                },
                Err(e) => io::println("✗ test_resolver_and_dep_graph_together failed: {}", e)
            }
        },
        Err(e) => io::println("✗ test_resolver_and_dep_graph_together failed: {}", e)
    }
}

fn test_cache_and_dep_graph_together() {
    let mut g = new_graph();
    add_dependency(&mut g, "app.ov".to_string(), "lib.ov".to_string());
    let deps = get_transitive_deps(&g, &"app.ov".to_string());
    let dep_pairs: Vec<(String, String)> = deps.iter()
        .map(|d| (d.clone(), compute_source_hash(d)))
        .collect();
    let deps_hash = compute_dependencies_hash(&dep_pairs);
    let config = default_cache_config("2.3.0".to_string());
    let mut cache = new_cache(config);
    let src_hash = compute_source_hash(&"fn main() {}".to_string());
    match cache_module(&mut cache, &"app.ov".to_string(),
                       src_hash.clone(), deps_hash.clone(),
                       &"artifact".to_string(), 0) {
        Ok(_) => {
            assert(is_cache_valid(&cache, &"app.ov".to_string(), &src_hash, &deps_hash, 0),
                   "Cache should be valid after storing");
            io::println("✓ test_cache_and_dep_graph_together passed");
        },
        Err(e) => io::println("✗ test_cache_and_dep_graph_together failed: {}", e)
    }
}

fn test_migrate_analyze_then_generate_toml() {
    let src = "let v = Vec::new(); let x = sin(0.0);".to_string();
    let used = analyze_used_symbols(&src);
    assert(!used.is_empty(), "Should detect symbols");
    let toml = generate_ovie_toml(&"my_project".to_string(), &"0.1.0".to_string());
    assert(toml.contains("[package]"), "TOML should have package section");
    assert(toml.contains("my_project"), "TOML should contain project name");
    io::println("✓ test_migrate_analyze_then_generate_toml passed");
}

fn test_load_with_compat_then_is_loaded() {
    let src = "export fn compute(x: Number) -> Number { x * 2 }".to_string();
    let path = "compute_module.ov".to_string();
    match load_with_compat(path.clone(), src) {
        Ok(_) => {
            assert(is_loaded(path), "Module should be loaded after load_with_compat");
            io::println("✓ test_load_with_compat_then_is_loaded passed");
        },
        Err(e) => io::println("✗ test_load_with_compat_then_is_loaded failed: {}", e)
    }
}

fn test_dep_graph_topological_sort_matches_load_levels() {
    let mut g = new_graph();
    add_dependency(&mut g, "c.ov".to_string(), "b.ov".to_string());
    add_dependency(&mut g, "b.ov".to_string(), "a.ov".to_string());
    match topological_sort(&g) {
        Ok(order) => {
            let levels = identify_load_levels(&g);
            assert(order[0] == "a.ov".to_string(), "a.ov should be first in topo order");
            assert(levels[0].modules.contains(&"a.ov".to_string()), "a.ov should be at level 0");
            io::println("✓ test_dep_graph_topological_sort_matches_load_levels passed");
        },
        Err(_) => assert(false, "Should not have cycles")
    }
}

fn test_lazy_registry_parse_uniqueness_across_calls() {
    let mut reg = new_lazy_registry();
    let src = "export fn unique_fn() {}".to_string();
    let path = "unique_test.ov".to_string();
    match get_or_parse(&mut reg, &path, src.clone()) {
        Ok(m1) => {
            match get_or_parse(&mut reg, &path, src.clone()) {
                Ok(m2) => {
                    match get_or_parse(&mut reg, &path, src) {
                        Ok(m3) => {
                            assert(m1.source_hash == m2.source_hash, "Hash should be same on second call");
                            assert(m2.source_hash == m3.source_hash, "Hash should be same on third call");
                            assert(reg.parsed.len() == 1, "Should only have 1 entry in parsed map");
                            io::println("✓ test_lazy_registry_parse_uniqueness_across_calls passed");
                        },
                        Err(e) => io::println("✗ test_lazy_registry_parse_uniqueness_across_calls failed: {}", e)
                    }
                },
                Err(e) => io::println("✗ test_lazy_registry_parse_uniqueness_across_calls failed: {}", e)
            }
        },
        Err(e) => io::println("✗ test_lazy_registry_parse_uniqueness_across_calls failed: {}", e)
    }
}

