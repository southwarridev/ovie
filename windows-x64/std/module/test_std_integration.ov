fn test_analyze_used_symbols_vec() {
    let src = "let v = Vec::new();".to_string();
    let used = analyze_used_symbols(&src);
    assert(used.contains_key("std::core"), "Should detect std::core usage");
    match used.get("std::core") {
        Some(syms) => assert(syms.contains(&"Vec".to_string()), "Should detect Vec"),
        None => assert(false, "std::core should be in used map")
    }
    io::println("✓ test_analyze_used_symbols_vec passed");
}

fn test_analyze_used_symbols_hashmap() {
    let src = "let m = HashMap::new();".to_string();
    let used = analyze_used_symbols(&src);
    assert(used.contains_key("std::core"), "Should detect std::core usage");
    match used.get("std::core") {
        Some(syms) => assert(syms.contains(&"HashMap".to_string()), "Should detect HashMap"),
        None => assert(false, "std::core should be in used map")
    }
    io::println("✓ test_analyze_used_symbols_hashmap passed");
}

fn test_analyze_used_symbols_math() {
    let src = "let x = sin(PI);".to_string();
    let used = analyze_used_symbols(&src);
    assert(used.contains_key("std::math"), "Should detect std::math usage");
    match used.get("std::math") {
        Some(syms) => {
            assert(syms.contains(&"sin".to_string()), "Should detect sin");
            assert(syms.contains(&"PI".to_string()), "Should detect PI");
        },
        None => assert(false, "std::math should be in used map")
    }
    io::println("✓ test_analyze_used_symbols_math passed");
}

fn test_analyze_used_symbols_io() {
    let src = "println(\"hello\");".to_string();
    let used = analyze_used_symbols(&src);
    assert(used.contains_key("std::io"), "Should detect std::io usage");
    io::println("✓ test_analyze_used_symbols_io passed");
}

fn test_analyze_used_symbols_multiple_modules() {
    let src = "let v = Vec::new(); let x = sin(0.0); println(\"hi\");".to_string();
    let used = analyze_used_symbols(&src);
    assert(used.contains_key("std::core"), "Should detect std::core");
    assert(used.contains_key("std::math"), "Should detect std::math");
    assert(used.contains_key("std::io"), "Should detect std::io");
    io::println("✓ test_analyze_used_symbols_multiple_modules passed");
}

fn test_analyze_used_symbols_empty_source() {
    let src = "".to_string();
    let used = analyze_used_symbols(&src);
    assert(used.is_empty(), "Empty source should have no symbols");
    io::println("✓ test_analyze_used_symbols_empty_source passed");
}

fn test_analyze_used_symbols_no_std_symbols() {
    let src = "fn add(a: Number, b: Number) -> Number { a + b }".to_string();
    let used = analyze_used_symbols(&src);
    assert(used.is_empty(), "Source with no std symbols should return empty map");
