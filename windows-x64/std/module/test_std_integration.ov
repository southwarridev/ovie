fn test_resolver_default_config_has_std_path() {
    let config = default_config();
    assert(config.std_lib_path == "std/".to_string(), "std_lib_path should be 'std/'");
    assert(!config.package_paths.is_empty(), "package_paths should not be empty");
    assert(config.current_dir == ".".to_string(), "current_dir should be '.'");
    assert(config.cache_enabled, "cache should be enabled");
    io::println("✓ test_resolver_default_config_has_std_path passed");
}

fn test_path_to_file_std_module() {
    let result = path_to_file("math".to_string());
    assert(result == "math/mod.ov".to_string(), "path_to_file('math') should return 'math/mod.ov'");
    io::println("✓ test_path_to_file_std_module passed");
}

fn test_path_to_file_already_ov() {
    let result = path_to_file("utils.ov".to_string());
    assert(result == "utils.ov".to_string(), "path_to_file for .ov file should be unchanged");
    io::println("✓ test_path_to_file_already_ov passed");
}

fn test_path_to_file_double_colon() {
    let result = path_to_file("std::core".to_string());
    assert(result == "std/core/mod.ov".to_string(), ":: should be replaced with /");
    io::println("✓ test_path_to_file_double_colon passed");
}

fn test_normalize_path_absolute_unchanged() {
    let result = normalize_path("/home/user/project".to_string(), "/base".to_string());
    assert(result == "/home/user/project".to_string(), "Absolute path should be unchanged");
    io::println("✓ test_normalize_path_absolute_unchanged passed");
}

fn test_normalize_path_relative_prepends_base() {
    let result = normalize_path("utils.ov".to_string(), "/project/src".to_string());
    assert(result == "/project/src/utils.ov".to_string(), "Relative path should be prepended with base");
    io::println("✓ test_normalize_path_relative_prepends_base passed");
}

fn test_is_valid_module_requires_ov_extension() {
    assert(is_valid_module("mod.ov".to_string()), "mod.ov should be valid");
    assert(!is_valid_module("mod.rs".to_string()), "mod.rs should not be valid");
    assert(!is_valid_module("mod".to_string()), "mod without extension should not be valid");
    assert(!is_valid_module("mod.txt".to_string()), "mod.txt should not be valid");
    io::println("✓ test_is_valid_module_requires_ov_extension passed");
}

fn test_search_paths_empty_dirs_returns_none() {
    let result = search_paths("math/mod.ov".to_string(), Vec::new());
    match result {
        None => io::println("✓ test_search_paths_empty_dirs_returns_none passed"),
        Some(_) => assert(false, "Empty dirs should return None")
    }
}

