/// Test suite for export statement parsing and validation (Task 2.3)
/// 
/// This test file verifies:
/// 1. Export statements are parsed correctly
/// 2. Exported symbols are validated to exist in the module
/// 3. Error handling for invalid exports
/// 4. Preservation of symbol names and type signatures

use std::io;
use ./loader::{load_module, register_export};
use ./types::{Module, ExportTable, ModuleError, FunctionSignature, TypeDefinition, ConstantInfo, EnumDefinition, Type, TypeKind, Parameter, Field, EnumVariant};
use std::core::{Vec, HashMap, Option, Result};

/// Test 1: Valid exports are registered correctly
fn test_valid_exports() {
    io::println("Test 1: Valid exports are registered correctly");
    
    // Create a test module with valid exports
    let mut module = Module {
        path: "test_module.ov".to_string(),
        name: "test_module".to_string(),
        exports: ExportTable {
            functions: HashMap::new(),
            types: HashMap::new(),
            constants: HashMap::new(),
            enums: HashMap::new()
        },
        imports: Vec::new(),
        source_hash: "test_hash".to_string(),
        compiled_at: 0,
        doc_comments: HashMap::new()
    };
    
    // Add a function to exports
    let func_sig = FunctionSignature {
        name: "test_function".to_string(),
        parameters: Vec::new(),
        return_type: Type {
            name: "i32".to_string(),
            is_generic: false,
            type_params: Vec::new()
        },
        doc_comment: "Test function".to_string(),
        is_generic: false
    };
    module.exports.functions.insert("test_function".to_string(), func_sig);
    
    // Validate the export
    match register_export(&mut module, "test_function".to_string(), "function".to_string()) {
        Ok(_) => io::println("  ✓ Valid function export registered successfully"),
        Err(e) => io::println("  ✗ Failed to register valid export: {}", e)
    }
}

/// Test 2: Exporting undefined function fails
fn test_undefined_function_export() {
    io::println("\nTest 2: Exporting undefined function fails");
    
    // Create a module without the function
    let mut module = Module {
        path: "test_module.ov".to_string(),
        name: "test_module".to_string(),
        exports: ExportTable {
            functions: HashMap::new(),
            types: HashMap::new(),
            constants: HashMap::new(),
            enums: HashMap::new()
        },
        imports: Vec::new(),
        source_hash: "test_hash".to_string(),
        compiled_at: 0,
        doc_comments: HashMap::new()
    };
    
    // Try to export a non-existent function
    match register_export(&mut module, "nonexistent_function".to_string(), "function".to_string()) {
        Ok(_) => io::println("  ✗ Should have failed to export undefined function"),
        Err(ModuleError::ExportError(msg)) => {
            io::println("  ✓ Correctly rejected undefined function export");
            io::println("    Error message: {}", msg);
        },
        Err(e) => io::println("  ✗ Wrong error type: {}", e)
    }
}

