/// Test 7: Symbol names and signatures are preserved
fn test_symbol_preservation() {
    io::println("\nTest 7: Symbol names and signatures are preserved");
    
    let mut module = Module {
        path: "test_module.ov".to_string(),
        name: "test_module".to_string(),
        exports: ExportTable {
            functions: HashMap::new(),
            types: HashMap::new(),
            constants: HashMap::new(),
            enums: HashMap::new()
        },
        imports: Vec::new(),
        source_hash: "test_hash".to_string(),
        compiled_at: 0,
        doc_comments: HashMap::new()
    };
    
    // Add a function with specific signature
    let original_func = FunctionSignature {
        name: "calculate".to_string(),
        parameters: vec![
            Parameter {
                name: "x".to_string(),
                param_type: Type {
                    name: "i32".to_string(),
                    is_generic: false,
                    type_params: Vec::new()
                },
                is_mutable: false
            },
            Parameter {
                name: "y".to_string(),
                param_type: Type {
                    name: "i32".to_string(),
                    is_generic: false,
                    type_params: Vec::new()
                },
                is_mutable: false
            }
        ],
        return_type: Type {
            name: "i64".to_string(),
            is_generic: false,
            type_params: Vec::new()
        },
        doc_comment: "Calculates something important".to_string(),
        is_generic: false
    };
    
    module.exports.functions.insert("calculate".to_string(), original_func.clone());
    
    // Verify the function is preserved correctly
    match module.exports.functions.get("calculate") {
        Some(func) => {
            let mut all_preserved = true;
            
            if func.name != original_func.name {
                io::println("  ✗ Function name not preserved");
                all_preserved = false;
            }
            
            if func.parameters.len() != original_func.parameters.len() {
                io::println("  ✗ Parameter count not preserved");
                all_preserved = false;
            }
            
            if func.return_type.name != original_func.return_type.name {
                io::println("  ✗ Return type not preserved");
                all_preserved = false;
            }
            
            if func.doc_comment != original_func.doc_comment {
                io::println("  ✗ Documentation not preserved");
                all_preserved = false;
            }
            
            if all_preserved {
                io::println("  ✓ All function signature information preserved correctly");
            }
        },
        None => io::println("  ✗ Function not found in exports")
    }
}

/// Test 8: Error messages list available symbols
fn test_error_messages_list_symbols() {
    io::println("\nTest 8: Error messages list available symbols");
    
    let mut module = Module {
        path: "test_module.ov".to_string(),
        name: "test_module".to_string(),
        exports: ExportTable {
            functions: HashMap::new(),
            types: HashMap::new(),
            constants: HashMap::new(),
            enums: HashMap::new()
        },
        imports: Vec::new(),
        source_hash: "test_hash".to_string(),
        compiled_at: 0,
        doc_comments: HashMap::new()
    };
    
    // Add some functions
    module.exports.functions.insert("func1".to_string(), FunctionSignature {
        name: "func1".to_string(),
        parameters: Vec::new(),
        return_type: Type { name: "()".to_string(), is_generic: false, type_params: Vec::new() },
        doc_comment: String::new(),
        is_generic: false
    });
    
    module.exports.functions.insert("func2".to_string(), FunctionSignature {
        name: "func2".to_string(),
        parameters: Vec::new(),
        return_type: Type { name: "()".to_string(), is_generic: false, type_params: Vec::new() },
        doc_comment: String::new(),
        is_generic: false
    });
    
    // Try to export non-existent function
    match register_export(&mut module, "func3".to_string(), "function".to_string()) {
        Ok(_) => io::println("  ✗ Should have failed"),
        Err(ModuleError::ExportError(msg)) => {
            if msg.contains("func1") && msg.contains("func2") {
                io::println("  ✓ Error message lists available functions");
                io::println("    Message: {}", msg);
            } else {
                io::println("  ✗ Error message doesn't list available functions");
                io::println("    Message: {}", msg);
            }
        },
        Err(e) => io::println("  ✗ Wrong error type: {}", e)
    }
}

/// Main test runner
fn main() {
    io::println("=== Export Validation Test Suite (Task 2.3) ===\n");
    
    test_valid_exports();
    test_undefined_function_export();
    test_undefined_type_export();
    test_undefined_constant_export();
    test_undefined_enum_export();
    test_invalid_symbol_type();
    test_symbol_preservation();
    test_error_messages_list_symbols();
    
    io::println("\n=== Test Suite Complete ===");
}
