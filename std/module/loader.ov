    names.join(", ")
}

/// Check for name collisions between imported symbols and a local namespace
///
/// Detects conflicts between:
/// 1. Imported symbols and locally defined symbols
/// 2. Symbols imported from different modules with the same name
///
/// # Parameters
/// - `module`: The module being validated
/// - `loaded_modules`: All modules loaded so far (for cross-module collision check)
///
/// # Returns
/// Result indicating success, or NameCollision error with details
///
/// # Examples
/// ```
/// let result = check_name_collisions(module, loaded_modules);
/// ```
export fn check_name_collisions(
    module: &Module,
    loaded_modules: &Vec<Module>
) -> ModuleResult<()> {
    // Build a map of symbol -> source_module for all imported symbols
    let mut imported_symbols: HashMap<String, String> = HashMap::new();

    for import in &module.imports {
        // Find the loaded module this import refers to
        let source_module = find_loaded_module(&imp.module_path, loaded_modules);

        match source_module {
            None => continue, // Module not loaded yet, skip collision check
            Some(src) => {
                // Determine which symbols are being imported
                let symbols_to_check = match &import.symbols {
                    // Specific symbols: use module_path::symbol as key
                    Some(syms) => syms.clone(),
                    // Import all: collect all exported symbol names
                    None => collect_all_exported_names(src)
                };

                // Use alias as the namespace prefix if present
                let namespace = match &import.alias {
                    Some(alias) => alias.clone(),
                    None => imp.module_path.clone()
                };

                for sym in symbols_to_check {
                    // When aliased, symbols are accessed as alias::sym, no collision
                    // When not aliased, check for direct name conflicts
                    if import.alias.is_none() {
                        if let Some(existing_source) = imported_symbols.get(&sym) {
                            if existing_source != &namespace {
                                return Err(ModuleError::NameCollision(
                                    format!(
                                        "Symbol '{}' is imported from both '{}' and '{}'. \
                                        Use explicit qualification: {}::{} or {}::{}",
                                        sym,
                                        existing_source,
                                        namespace,
                                        existing_source, sym,
                                        namespace, sym
                                    )
                                ));
                            }
                        } else {
                            imported_symbols.insert(sym, namespace.clone());
                        }
                    }
                }
            }
        }
    }

    // Check imported symbols against local definitions
    check_imported_vs_local(module, &imported_symbols)?;

    Ok(())
}

/// Check that imported symbol names don't shadow local definitions
///
/// # Parameters
/// - `module`: The module to check
/// - `imported_symbols`: Map of symbol name -> source module path
///
/// # Returns
/// Result indicating success or NameCollision error
fn check_imported_vs_local(
    module: &Module,
    imported_symbols: &HashMap<String, String>
) -> ModuleResult<()> {
    // Check functions
    for (name, _) in &module.exports.functions {
        if let Some(source) = imported_symbols.get(name) {
            return Err(ModuleError::NameCollision(
                format!(
                    "Local function '{}' conflicts with imported symbol '{}' from '{}'. \
                    Rename the local function or use an alias for the import.",
                    name, name, source
                )
            ));
        }
    }

    // Check types
    for (name, _) in &module.exports.types {
        if let Some(source) = imported_symbols.get(name) {
            return Err(ModuleError::NameCollision(
                format!(
                    "Local type '{}' conflicts with imported symbol '{}' from '{}'. \
                    Rename the local type or use an alias for the import.",
                    name, name, source
                )
            ));
        }
    }

    // Check constants
    for (name, _) in &module.exports.constants {
        if let Some(source) = imported_symbols.get(name) {
            return Err(ModuleError::NameCollision(
                format!(
                    "Local constant '{}' conflicts with imported symbol '{}' from '{}'. \
                    Rename the local constant or use an alias for the import.",
                    name, name, source
                )
            ));
        }
    }

    // Check enums
    for (name, _) in &module.exports.enums {
        if let Some(source) = imported_symbols.get(name) {
            return Err(ModuleError::NameCollision(
                format!(
                    "Local enum '{}' conflicts with imported symbol '{}' from '{}'. \
                    Rename the local enum or use an alias for the import.",
                    name, name, source
                )
            ));
        }
    }

    Ok(())
}

/// Collect all exported symbol names from a module
///
/// # Parameters
/// - `module`: The module to collect names from
///
/// # Returns
/// Vec of all exported symbol names
fn collect_all_exported_names(module: &Module) -> Vec<String> {
    let mut names = Vec::new();
    for (name, _) in &module.exports.functions {
        names.push(name.clone());
    }
    for (name, _) in &module.exports.types {
        names.push(name.clone());
    }
    for (name, _) in &module.exports.constants {
        names.push(name.clone());
    }
    for (name, _) in &module.exports.enums {
        names.push(name.clone());
    }
    names
}

/// Find a loaded module by its import path
///
/// # Parameters
/// - `import_path`: The module path from an import statement
/// - `loaded_modules`: All currently loaded modules
///
/// # Returns
/// Option containing a reference to the matching module
fn find_loaded_module(import_path: String, loaded_modules: Vec<Module>) -> Option<Module> {
    for m in loaded_modules {
        // Match by path or by name (handles both "std::math" and "std/math/mod.ov")
        if &m.path == import_path || &m.name == import_path {
            return Some(m);
        }
        // Also match if the import path is a suffix of the module path
        if m.path.ends_with(import_path.as_str()) {
            return Some(m);
        }
    }
    None
}

/// Load a module directly from source content (used by lazy registry)
///
/// Unlike `load_module()` which reads from disk, this accepts pre-loaded source.
/// Ensures the module is registered in the global cache after parsing.
///
/// # Parameters
/// - `path`: Module path identifier
/// - `source`: Source code content
///
/// # Returns
/// Result containing the parsed Module
///
/// # Examples
/// ```
/// let module = load_module_from_source("std/math/mod.ov", source_str)?;
/// ```
export fn load_module_from_source(path: String, source: String) -> ModuleResult<Module> {
    // Return cached module if already parsed (parse-at-most-once guarantee)
    if is_loaded(path.clone()) {
        return Ok(get_module(path).unwrap());
    }

    let module = parse_module(path.clone(), source)?;

    unsafe {
        LOADED_MODULES.insert(path.clone(), module.clone());
    }

    Ok(module)
}

// ============================================================
// Backward Compatibility Layer (Tasks 17.1, 17.2)
// ============================================================

/// Detect if a source file is a standalone .ov file (legacy mode)
///
/// A file is considered standalone if it contains no `import`, `use`, or
/// `export` statements. Such files are compiled using legacy semantics
/// without the module system, preserving backward compatibility.
///
/// # Parameters
/// - `source`: Source code content to inspect
///
/// # Returns
/// true if the file has no import/export statements (standalone/legacy mode)
///
/// # Examples
/// ```
/// let src = "fn main() { seeAm(\"hello\"); }";
/// assert(is_standalone_file(src) == true);
/// ```
export fn is_standalone_file(source: &String) -> bool {
    // A file is standalone if it has no module-system keywords at the top level
    let lines: Vec<String> = source.lines().map(|l| l.trim().to_string()).collect();

    for line in &lines {
        // Skip blank lines and comments
        if line.is_empty() || line.starts_with("//") || line.starts_with("///") {
            continue;
        }
        // If any non-comment line starts with import/use/export, it's modular
        if line.starts_with("import ") || line.starts_with("use ") || line.starts_with("export ") {
            return false;
        }
    }
    true
}

/// Load a standalone .ov file using legacy semantics
///
/// Standalone files are compiled without the module system. They have access
/// to built-in functions and types but cannot import other modules.
/// This preserves backward compatibility with pre-2.3 Ovie code.
///
/// # Parameters
/// - `path`: Path to the .ov file
/// - `source`: Source code content
///
/// # Returns
/// Result containing a Module with no imports/exports (legacy module)
///
/// # Examples
/// ```
/// let module = load_standalone("examples/hello.ov", source)?;
/// assert(module.imports.is_empty());
/// assert(module.exports.is_empty());
/// ```
export fn load_standalone(path: String, source: String) -> ModuleResult<Module> {
    // Return cached if already loaded
    if is_loaded(path.clone()) {
        return Ok(get_module(path).unwrap());
    }

    // Parse as a module but mark it as standalone (no imports/exports enforced)
    let mut module = parse_module(path.clone(), source)?;
    module.is_standalone = true;

    unsafe {
        LOADED_MODULES.insert(path.clone(), module.clone());
    }

    Ok(module)
}

/// Determine the correct load mode for a source file and load it
///
/// Automatically detects whether a file is standalone or modular and
/// dispatches to the appropriate loader. This is the primary entry point
/// for the compatibility layer.
///
/// # Parameters
/// - `path`: Path to the .ov file
/// - `source`: Source code content
///
/// # Returns
/// Result containing the loaded Module
///
/// # Examples
/// ```
/// let module = load_with_compat("examples/hello.ov", source)?;
/// ```
export fn load_with_compat(path: String, source: String) -> ModuleResult<Module> {
    if is_standalone_file(&source) {
        load_standalone(path, source)
    } else {
        load_module_from_source(path, source)
    }
}

/// Check if a loaded module was compiled in standalone (legacy) mode
///
/// # Parameters
/// - `module`: The module to check
///
/// # Returns
/// true if the module was loaded as a standalone file
///
/// # Examples
/// ```
/// if is_legacy_module(&module) {
///     // handle legacy semantics
/// }
/// ```
export fn is_legacy_module(module: &Module) -> bool {
    module.is_standalone
}

// ============================================================
// Compatibility Mode for Legacy Std Usage (Task 17.2)
// ============================================================

/// Compatibility mode configuration
///
/// Controls how the module system handles legacy code that uses
/// the standard library without explicit import/export statements.
struct CompatMode {
    /// Allow standalone files to implicitly access std builtins
    allow_implicit_std: bool,
    /// Emit deprecation warnings for legacy usage patterns
    warn_on_legacy: bool,
    /// Treat missing exports as warnings rather than errors
    lenient_exports: bool
}

/// Default compatibility mode — permissive for smooth migration
///
/// # Returns
/// CompatMode with safe defaults that allow legacy code to compile
///
/// # Examples
/// ```
/// let compat = default_compat_mode();
/// assert(compat.allow_implicit_std == true);
/// ```
export fn default_compat_mode() -> CompatMode {
    CompatMode {
        allow_implicit_std: true,
        warn_on_legacy: true,
        lenient_exports: false
    }
}

/// Strict compatibility mode — enforces full module system usage
///
/// # Returns
/// CompatMode that requires explicit imports/exports
///
/// # Examples
/// ```
/// let compat = strict_compat_mode();
/// assert(compat.allow_implicit_std == false);
/// ```
export fn strict_compat_mode() -> CompatMode {
    CompatMode {
        allow_implicit_std: false,
        warn_on_legacy: false,
        lenient_exports: false
    }
}

/// Load a module respecting the given compatibility mode
///
/// In permissive mode, standalone files are allowed and legacy std usage
/// is supported. In strict mode, all files must use explicit imports/exports.
///
/// # Parameters
/// - `path`: Path to the .ov file
/// - `source`: Source code content
/// - `compat`: Compatibility mode configuration
///
/// # Returns
/// Result containing the loaded Module
///
/// # Examples
/// ```
/// let compat = default_compat_mode();
/// let module = load_with_mode("examples/hello.ov", source, compat)?;
/// ```
export fn load_with_mode(
    path: String,
    source: String,
    compat: CompatMode
) -> ModuleResult<Module> {
    let standalone = is_standalone_file(&source);

    if standalone && !compat.allow_implicit_std {
        return Err(ModuleError::ParseError(format!(
            "File '{}' has no import/export statements. \
             Use explicit imports or enable compatibility mode.",
            path
        )));
    }

    if standalone && compat.warn_on_legacy {
        // Emit a deprecation warning (non-fatal)
        eprintln(&format!(
            "Warning: '{}' uses legacy standalone mode. \
             Consider adding explicit import/export statements.",
            path
        ));
    }

    load_with_compat(path, source)
}

/// Check if a module uses legacy std library access patterns
///
/// Detects patterns like `use core::{...}` without a preceding `import`
/// that indicate the old implicit std access style.
///
/// # Parameters
/// - `source`: Source code to inspect
///
/// # Returns
/// true if legacy std usage patterns are detected
///
/// # Examples
/// ```
/// let src = "use core::{Vec};\nfn main() {}";
/// assert(has_legacy_std_usage(src) == true);
/// ```
export fn has_legacy_std_usage(source: &String) -> bool {
    // Legacy pattern: `use core::{...}` or `use fs::{...}` without full path
    let legacy_patterns = vec![
        "use core::",
        "use fs::",
        "use io::",
        "use math::",
        "use time::",
        "use env::",
        "use cli::",
        "use log::",
        "use testing::",
    ];

    for pattern in &legacy_patterns {
        if source.contains(pattern) {
            return true;
        }
    }
    false
}

