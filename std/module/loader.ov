/// Get list of available functions for error messages
fn get_available_functions(module: &Module) -> String {
    let mut names = Vec::new();
    for (name, _) in &module.exports.functions {
        names.push(name.clone());
    }
    if names.is_empty() {
        return "(none)".to_string();
    }
    names.join(", ")
}

/// Get list of available types for error messages
fn get_available_types(module: &Module) -> String {
    let mut names = Vec::new();
    for (name, _) in &module.exports.types {
        names.push(name.clone());
    }
    if names.is_empty() {
        return "(none)".to_string();
    }
    names.join(", ")
}

/// Get list of available constants for error messages
fn get_available_constants(module: &Module) -> String {
    let mut names = Vec::new();
    for (name, _) in &module.exports.constants {
        names.push(name.clone());
    }
    if names.is_empty() {
        return "(none)".to_string();
    }
    names.join(", ")
}

/// Get list of available enums for error messages
fn get_available_enums(module: &Module) -> String {
    let mut names = Vec::new();
    for (name, _) in &module.exports.enums {
        names.push(name.clone());
    }
    if names.is_empty() {
        return "(none)".to_string();
