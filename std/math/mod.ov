// Ovie Standard Library - Math Module
// Parser-compatible version: no const type annotations, no impl blocks,
// no scientific notation literals, no inline if-expressions.

// ===== CONSTANTS (as variables, parser-compatible) =====
PI = 3.141592653589793
E = 2.718281828459045
TAU = 6.283185307179586
SQRT2 = 1.4142135623730951
SQRT3 = 1.7320508075688772
LN2 = 0.6931471805599453
LN10 = 2.302585092994046
EPSILON = 0.000000000000000222

// ===== ABS =====
fn abs(x) {
    if x < 0 {
        return x * -1
    }
    return x
}

// ===== FLOOR / CEIL / ROUND =====
fn floor(x) {
    mut n = 0 - (0 - x)   // workaround: cast via subtraction
    if x >= 0 {
        mut i = 0
        while i + 1 <= x { i += 1 }
        return i
    }
    mut i = 0
    while i > x { i -= 1 }
    return i
}

fn ceil(x) {
    if x >= 0 {
        mut i = 0
        while i < x { i += 1 }
        return i
    }
    mut i = 0
    while i - 1 >= x { i -= 1 }
    return i
}

fn round(x) {
    if x >= 0 {
        return floor(x + 0.5)
    }
    return ceil(x - 0.5)
}

// ===== MIN / MAX / CLAMP =====
fn min(a, b) {
    if a < b { return a }
    return b
}

fn max(a, b) {
    if a > b { return a }
    return b
}

fn clamp(x, lo, hi) {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

// ===== POWER =====
fn pow(base, exp) {
    if exp == 0 { return 1 }
    if exp < 0 {
        return 1 / pow(base, exp * -1)
    }
    mut result = 1
    mut i = 0
    while i < exp {
        result = result * base
        i += 1
    }
    return result
}

// ===== SQRT (Newton-Raphson, 60 iterations) =====
fn sqrt(x) {
    if x < 0 { return 0 }
    if x == 0 { return 0 }
    mut guess = x / 2
    mut i = 0
    while i < 60 {
        mut next = (guess + x / guess) / 2
        mut diff = next - guess
        if diff < 0 { diff = diff * -1 }
        if diff < 0.000000001 {
            return next
        }
        guess = next
        i += 1
    }
    return guess
}

// ===== LOG (natural, Newton approximation) =====
fn log(x) {
    if x <= 0 { return 0 }
    if x == 1 { return 0 }
    // Use identity: ln(x) = 2 * atanh((x-1)/(x+1))
    mut y = (x - 1) / (x + 1)
    mut y2 = y * y
    mut result = 0
    mut term = y
    mut i = 1
    while i <= 40 {
        result = result + term / i
        term = term * y2
        i = i + 2
    }
    return result * 2
}

fn log2(x) {
    return log(x) / LN2
}

fn log10(x) {
    return log(x) / LN10
}

// ===== TRIG (Taylor series) =====
fn sin(x) {
    // Normalize x to [-PI, PI]
    mut a = x
    while a > PI  { a = a - TAU }
    while a < 0 - PI { a = a + TAU }
    mut result = 0
    mut term = a
    mut i = 1
    while i <= 15 {
        result = result + term
        term = term * (0 - a * a) / ((2 * i) * (2 * i + 1))
        i += 1
    }
    return result
}

fn cos(x) {
    return sin(x + PI / 2)
}

fn tan(x) {
    mut c = cos(x)
    if c == 0 { return 0 }
    return sin(x) / c
}

// ===== IS HELPERS =====
fn is_nan(x) {
    return x != x
}

fn is_infinite(x) {
    return x == x + 1
}

fn is_integer(x) {
    return x == floor(x)
}

fn is_even(x) {
    mut half = x / 2
    return floor(half) == half
}

fn is_odd(x) {
    return is_even(x) == false
}

// ===== GCD / LCM =====
fn gcd(a, b) {
    mut x = abs(a)
    mut y = abs(b)
    while y != 0 {
        mut t = y
        y = x - floor(x / y) * y
        x = t
    }
    return x
}

fn lcm(a, b) {
    if a == 0 { return 0 }
    if b == 0 { return 0 }
    return abs(a * b) / gcd(a, b)
}

// ===== FACTORIAL =====
fn factorial(n) {
    if n <= 1 { return 1 }
    mut result = 1
    mut i = 2
    while i <= n {
        result = result * i
        i += 1
    }
    return result
}

// ===== HYPOTENUSE =====
fn hypot(a, b) {
    return sqrt(a * a + b * b)
}

// ===== DEGREES / RADIANS =====
fn to_radians(deg) {
    return deg * PI / 180
}

fn to_degrees(rad) {
    return rad * 180 / PI
}
