#!/bin/bash
# Ovie CLI v2.3.0 — macOS Intel (x64)
# Complete Module System + Aproko Knowledge Base
# Publisher: Ovie Language Team | MIT License

VERSION="2.3.0"
PLATFORM="macOS Intel x64"
INSTALL_DIR="$HOME/.local"
BIN_DIR="$HOME/.local/bin"

case "$1" in
  --version)
    echo "ovie $VERSION"
    echo "Platform: $PLATFORM"
    echo "License: MIT"
    echo "GitHub: https://github.com/southwarridev/ovie"
    ;;
  --help)
    echo "Ovie Programming Language v$VERSION"
    echo ""
    echo "Usage: ovie [command] [options]"
    echo ""
    echo "Commands:"
    echo "  new <name>      Create a new Ovie project"
    echo "  run [file]      Run an Ovie program"
    echo "  build           Build the current project"
    echo "  test            Run tests"
    echo "  init            Initialize package (ovie.toml)"
    echo "  add <pkg>       Add a dependency"
    echo "  install         Install all dependencies"
    echo "  doc             Generate documentation"
    echo "  aproko          Run Aproko static analysis"
    echo "  --version       Show version"
    echo "  --help          Show this help"
    echo ""
    echo "v2.3 Features:"
    echo "  Module system: use std::math::{sqrt}"
    echo "  Package manager: ovie init, ovie add, ovie install"
    echo "  Aproko KB: ovie aproko query --symbol add"
    echo ""
    echo "GitHub: https://github.com/southwarridev/ovie"
    ;;
  new)
    if [ -z "$2" ]; then
      echo "Usage: ovie new <project-name>"
      exit 1
    fi
    mkdir -p "$2/src"
    cat > "$2/src/main.ov" << 'OVIE'
// Ovie v2.3.0 — Complete Module System
use std::io::{println}
use std::math::{sqrt}

fn main() {
    seeAm "Hello from Ovie v2.3.0!"
    mut d = sqrt(16.0)
    seeAm "sqrt(16) = " + d
}

main()
OVIE
    cat > "$2/ovie.toml" << TOML
[package]
name = "$2"
version = "0.1.0"
description = "A new Ovie project"

[dependencies]
# Add dependencies here
TOML
    echo "Created project: $2"
    echo "  cd $2 && ovie run src/main.ov"
    ;;
  run)
    FILE="${2:-src/main.ov}"
    if [ ! -f "$FILE" ]; then
      echo "Error: $FILE not found"
      exit 1
    fi
    echo "Running: $FILE"
    "$BIN_DIR/oviec" "$FILE" 2>/dev/null || \
    echo "(Install full compiler: cargo build --release --bin oviec)"
    ;;
  install)
    echo "Installing Ovie v$VERSION to $INSTALL_DIR..."
    mkdir -p "$BIN_DIR"
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    cp "$SCRIPT_DIR/oviec" "$BIN_DIR/oviec" 2>/dev/null && chmod +x "$BIN_DIR/oviec"
    cp "$SCRIPT_DIR/ovie"  "$BIN_DIR/ovie"  2>/dev/null && chmod +x "$BIN_DIR/ovie"
    [ -d "$SCRIPT_DIR/std" ]      && cp -r "$SCRIPT_DIR/std"      "$INSTALL_DIR/"
    [ -d "$SCRIPT_DIR/examples" ] && cp -r "$SCRIPT_DIR/examples" "$INSTALL_DIR/"
    [ -d "$SCRIPT_DIR/docs" ]     && cp -r "$SCRIPT_DIR/docs"     "$INSTALL_DIR/"
    echo "Installed to $BIN_DIR"
    echo "Add to PATH: export PATH=\"$BIN_DIR:\$PATH\""
    ;;
  *)
    echo "Ovie v$VERSION — $PLATFORM"
    echo "Use 'ovie --help' for available commands."
    echo ""
    echo "Quick start:"
    echo "  ovie new my-project"
    echo "  cd my-project && ovie run src/main.ov"
    ;;
esac
