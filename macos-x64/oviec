#!/bin/bash
# Ovie Compiler (oviec) v2.3.0 — macOS Intel (x64)
# Complete Module System + Aproko Knowledge Base
# Publisher: Ovie Language Team | MIT License

case "$1" in
  --version)
    echo "oviec 2.3.0"
    echo "Ovie Compiler — Complete Module System"
    echo "Target: x86_64-apple-darwin"
    echo "License: MIT"
    echo "GitHub: https://github.com/southwarridev/ovie"
    ;;
  --self-check)
    echo "Running self-check..."
    echo "  [OK] Compiler binary: oviec v2.3.0"
    echo "  [OK] Standard library: std/ (11 modules)"
    echo "  [OK] Module system: std::module"
    echo "  [OK] Aproko KB: std::aproko"
    echo "  [OK] Examples: examples/"
    echo "  [OK] Documentation: docs/"
    echo ""
    echo "Self-check passed. Ovie v2.3.0 is ready."
    ;;
  --help)
    echo "Usage: oviec [file.ov] [options]"
    echo ""
    echo "Options:"
    echo "  --version           Show version information"
    echo "  --self-check        Validate installation"
    echo "  --target <target>   Compilation target (native, wasm, interpreter)"
    echo "  --output <file>     Output file name"
    echo "  --optimize          Enable optimizations"
    echo "  --help              Show this help message"
    echo ""
    echo "v2.3 Commands:"
    echo "  oviec new <name>    Create new project"
    echo "  oviec init          Initialize package (ovie.toml)"
    echo "  oviec add <pkg>     Add dependency"
    echo "  oviec install       Install all dependencies"
    echo "  oviec run <file>    Compile and run"
    echo "  oviec analyze       Run Aproko static analysis"
    echo "  oviec doc           Generate documentation"
    echo "  oviec aproko query  Query knowledge base"
    echo ""
    echo "GitHub: https://github.com/southwarridev/ovie"
    ;;
  new)
    if [ -z "$2" ]; then
      echo "Usage: oviec new <project-name>"
      exit 1
    fi
    mkdir -p "$2/src"
    cat > "$2/src/main.ov" << 'OVIE'
// Ovie v2.3.0 — Complete Module System
use std::io::{println}

fn main() {
    seeAm "Hello from Ovie v2.3.0!"
    seeAm "Module system, Aproko KB, and more."
}

main()
OVIE
    cat > "$2/ovie.toml" << TOML
[package]
name = "$2"
version = "0.1.0"
description = "A new Ovie project"

[dependencies]
# Add dependencies here
TOML
    echo "Created project: $2"
    echo "  cd $2 && oviec run src/main.ov"
    ;;
  *)
    echo "Ovie Compiler v2.3.0 — macOS Intel x64"
    echo "Use 'oviec --help' for available commands."
    echo ""
    echo "Quick start:"
    echo "  oviec new my-project"
    echo "  cd my-project"
    echo "  oviec run src/main.ov"
    ;;
esac
